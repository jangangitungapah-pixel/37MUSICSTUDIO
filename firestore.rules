rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared settings can be read by anyone, but only written by authenticated non-anonymous users
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Bookings can be read by anyone (public calendar) but only written by admins
    match /bookings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Customers and inventory can only be accessed by authenticated non-anonymous users
    match /customers/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    match /inventory/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Finances
    match /finances/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminUid() {
      return isSignedIn()
        && request.auth.uid in ["X04qB13q6oVHRPSaAq3cEGGCc0o2"];
    }

    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in ["muhammadariefrahmadi@gmail.com"];
    }

    function isAdmin() {
      return isAdminUid() || isAdminEmail();
    }

    match /bookings/{bookingId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /bookingAuditLogs/{auditLogId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
   
    match /inventoryItems/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /inventoryActivityLogs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    
    match /billingTransactions/{transactionId} {
  		allow read, create, update: if isAdmin();
  		allow delete: if false;
		}

		match /billingAuditLogs/{auditLogId} {
  		allow read, create: if isAdmin();
  		allow update, delete: if false;
		}

		match /bookkeepingEntries/{entryId} {
			allow read, create, update, delete: if isAdmin();
		}

		match /bookkeepingAuditLogs/{auditLogId} {
			allow read, create: if isAdmin();
			allow update, delete: if false;
		}
  }
}
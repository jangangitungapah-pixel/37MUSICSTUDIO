rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function signedInGuestOrStaff() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasAdminAccess() {
      return signedInStaff()
        && (
          request.auth.token.admin == true
          || (
            exists(userPath())
            && get(userPath()).data.role in ['admin', 'staff']
          )
        );
    }

    function isSelf(userId) {
      return signedInStaff() && request.auth.uid == userId;
    }

    function isPublicBookingShape() {
      return request.resource.data.keys().hasOnly(['id', 'date', 'hour', 'duration', 'status', 'type', 'roomId'])
        && request.resource.data.id is number
        && request.resource.data.date is string
        && request.resource.data.hour is number
        && request.resource.data.duration is number
        && request.resource.data.status in ['pending', 'dp', 'confirmed', 'maintenance', 'cancelled']
        && request.resource.data.type in ['booking', 'recording', 'maintenance']
        && (!('roomId' in request.resource.data) || request.resource.data.roomId is string);
    }

    // Shared settings/config are readable by the app and public calendar.
    // Writes require an admin/staff role or a Firebase Auth custom claim.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    // Full booking documents may include customer contact/payment details.
    // Public calendar must read from publicBookings instead.
    match /bookings/{document=**} {
      allow read, write: if hasAdminAccess();
    }

    match /publicBookings/{bookingId} {
      allow read: if signedInGuestOrStaff();
      allow create, update: if hasAdminAccess() && isPublicBookingShape();
      allow delete: if hasAdminAccess();
    }

    match /bookingRequests/{requestId} {
      allow read: if hasAdminAccess();
      allow create: if signedInGuestOrStaff()
        && request.resource.data.keys().hasOnly([
          'id', 'band', 'phone', 'date', 'hour', 'duration',
          'estimatedPrice', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.band is string
        && request.resource.data.date is string
        && request.resource.data.hour is number
        && request.resource.data.duration is number;
      allow update, delete: if hasAdminAccess();
    }

    match /auditLogs/{document=**} {
      allow read, write: if hasAdminAccess();
    }

    match /users/{userId} {
      allow read: if hasAdminAccess() || isSelf(userId);
      allow create: if hasAdminAccess()
        || (
          isSelf(userId)
          && request.resource.data.keys().hasOnly(['uid', 'email', 'username', 'phone', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
        );
      allow update: if hasAdminAccess()
        || (
          isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'phone'])
        );
      allow delete: if hasAdminAccess();
    }

    match /customers/{document=**} {
      allow read, write: if hasAdminAccess();
    }
    
    match /inventory/{document=**} {
      allow read, write: if hasAdminAccess();
    }

    match /finances/{document=**} {
      allow read, write: if hasAdminAccess();
    }

    match /gallery/{document=**} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /albums/{document=**} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    match /usernames/{document=**} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }
  }
}

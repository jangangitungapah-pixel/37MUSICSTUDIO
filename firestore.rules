rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInNonAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function signedInGuestOrStaff() {
      return signedIn();
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedInNonAnonymous() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isActiveUser() {
      return hasUserProfile()
        && (
          !('status' in userData())
          || userData().status == 'active'
        );
    }

    function isAdmin() {
      return isActiveUser()
        && (
          request.auth.token.admin == true
          || userData().role == 'admin'
        );
    }

    function isStaffRole() {
      return isActiveUser()
        && userData().role in ['admin', 'staff'];
    }

    function hasPermission(permission) {
      return isAdmin()
        || (
          isStaffRole()
          && userData().role == 'staff'
          && userData().permissions is list
          && permission in userData().permissions
        );
    }

    function isSelf(userId) {
      return signedInNonAnonymous() && request.auth.uid == userId;
    }

    function selfUserCreateShape() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'username',
          'displayName',
          'phone',
          'photoURL',
          'role',
          'status',
          'provider',
          'linkedCustomerId',
          'projectName',
          'clientType',
          'primaryGenre',
          'mainNeed',
          'memberCount',
          'preferredDuration',
          'preferredTime',
          'preferredDays',
          'socialLink',
          'gearNotes',
          'invoiceName',
          'paymentPreference',
          'clientLevel',
          'createdAt',
          'lastLoginAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'client'
        && request.resource.data.status == 'active';
    }

    function selfUserSafeUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username',
          'displayName',
          'phone',
          'photoURL',
          'fcmTokens',
          'requiresPasswordChange',
          'passwordUpdatedAt',
          'lastLoginAt',
          'provider',
          'email',
          'projectName',
          'clientType',
          'primaryGenre',
          'mainNeed',
          'memberCount',
          'preferredDuration',
          'preferredTime',
          'preferredDays',
          'socialLink',
          'gearNotes',
          'invoiceName',
          'paymentPreference',
          'clientLevel',
          'profileUpdatedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requiresPasswordChange'])
          || request.resource.data.requiresPasswordChange == false
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
          || request.resource.data.email == request.auth.token.email
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientLevel'])
          || (
            !('clientLevel' in resource.data)
            && request.resource.data.clientLevel == 'New'
          )
          || (
            'clientLevel' in resource.data
            && request.resource.data.clientLevel == resource.data.clientLevel
          )
        );
    }

    function isSelfUsernameMappingCreate() {
      return signedInNonAnonymous()
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
    }

    function isSelfUsernameMappingDelete() {
      return signedInNonAnonymous()
        && resource.data.uid == request.auth.uid;
    }

    function isPublicBookingShape() {
      return request.resource.data.keys().hasOnly([
          'id',
          'date',
          'hour',
          'duration',
          'status',
          'type',
          'roomId'
        ])
        && request.resource.data.id is number
        && request.resource.data.date is string
        && request.resource.data.hour is number
        && request.resource.data.duration is number
        && request.resource.data.status in ['pending', 'dp', 'confirmed', 'maintenance', 'cancelled']
        && request.resource.data.type in ['booking', 'recording', 'maintenance']
        && (!('roomId' in request.resource.data) || request.resource.data.roomId is string);
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('settings');
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission('settings') || hasPermission('inventory');
    }

    match /bookings/{document=**} {
      allow read: if hasPermission('calendar') || hasPermission('billing') || hasPermission('finance');
      allow write: if hasPermission('calendar') || hasPermission('billing');
    }

    match /publicBookings/{bookingId} {
      allow read: if signedInGuestOrStaff();
      allow create, update: if (hasPermission('calendar') || hasPermission('billing')) && isPublicBookingShape();
      allow delete: if hasPermission('calendar') || hasPermission('billing');
    }

    match /bookingRequests/{requestId} {
      allow read: if hasPermission('calendar')
        || hasPermission('billing')
        || (
          signedInNonAnonymous()
          && resource.data.clientUid == request.auth.uid
        );

      allow create: if signedInGuestOrStaff()
        && request.resource.data.keys().hasOnly([
          'id',
          'band',
          'phone',
          'date',
          'hour',
          'duration',
          'estimatedPrice',
          'source',
          'status',
          'createdAt',
          'clientUid',
          'clientEmail',
          'clientName',
          'clientPhone',
          'linkedCustomerId',
          'projectName',
          'clientType',
          'primaryGenre',
          'mainNeed',
          'memberCount',
          'preferredDuration',
          'preferredTime',
          'preferredDays',
          'socialLink',
          'gearNotes',
          'invoiceName',
          'paymentPreference',
          'clientLevel',
          'createdBy'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.band is string
        && request.resource.data.phone is string
        && request.resource.data.date is string
        && request.resource.data.hour is number
        && request.resource.data.duration is number
        && request.resource.data.estimatedPrice is number
        && request.resource.data.source is string
        && request.resource.data.createdAt is string
        && (
          !('clientUid' in request.resource.data)
          || request.resource.data.clientUid == ''
          || (
            signedInNonAnonymous()
            && request.resource.data.clientUid == request.auth.uid
          )
        )
        && (!('clientEmail' in request.resource.data) || request.resource.data.clientEmail is string)
        && (!('clientName' in request.resource.data) || request.resource.data.clientName is string)
        && (!('clientPhone' in request.resource.data) || request.resource.data.clientPhone is string)
        && (!('linkedCustomerId' in request.resource.data) || request.resource.data.linkedCustomerId is string)
        && (!('projectName' in request.resource.data) || request.resource.data.projectName is string)
        && (!('clientType' in request.resource.data) || request.resource.data.clientType is string)
        && (!('primaryGenre' in request.resource.data) || request.resource.data.primaryGenre is string)
        && (!('mainNeed' in request.resource.data) || request.resource.data.mainNeed is string)
        && (!('memberCount' in request.resource.data) || request.resource.data.memberCount is string)
        && (!('preferredDuration' in request.resource.data) || request.resource.data.preferredDuration is string)
        && (!('preferredTime' in request.resource.data) || request.resource.data.preferredTime is string)
        && (!('preferredDays' in request.resource.data) || request.resource.data.preferredDays is string)
        && (!('socialLink' in request.resource.data) || request.resource.data.socialLink is string)
        && (!('gearNotes' in request.resource.data) || request.resource.data.gearNotes is string)
        && (!('invoiceName' in request.resource.data) || request.resource.data.invoiceName is string)
        && (!('paymentPreference' in request.resource.data) || request.resource.data.paymentPreference is string)
        && (!('clientLevel' in request.resource.data) || request.resource.data.clientLevel is string)
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy is string);

      allow update, delete: if hasPermission('calendar') || hasPermission('billing');
    } {
      allow read: if hasPermission('calendar')
        || hasPermission('billing')
        || (
          signedInNonAnonymous()
          && resource.data.clientUid == request.auth.uid
        );

      allow create: if signedInGuestOrStaff()
        && request.resource.data.keys().hasOnly([
          'id',
          'band',
          'phone',
          'date',
          'hour',
          'duration',
          'estimatedPrice',
          'source',
          'status',
          'createdAt',
          'clientUid',
          'clientEmail',
          'clientName',
          'clientPhone',
          'linkedCustomerId',
          'createdBy'
                  'projectName',
          'clientType',
          'primaryGenre',
          'mainNeed',
          'memberCount',
          'preferredDuration',
          'preferredTime',
          'preferredDays',
          'socialLink',
          'gearNotes',
          'invoiceName',
          'paymentPreference',
          'clientLevel',
])
        && request.resource.data.status == 'pending'
        && request.resource.data.band is string
        && request.resource.data.phone is string
        && request.resource.data.date is string
        && request.resource.data.hour is number
        && request.resource.data.duration is number
        && request.resource.data.estimatedPrice is number
        && request.resource.data.source is string
        && request.resource.data.createdAt is string
        && (
          !('clientUid' in request.resource.data)
          || request.resource.data.clientUid == ''
          || (
            signedInNonAnonymous()
            && request.resource.data.clientUid == request.auth.uid
          )
        )
        && (!('clientEmail' in request.resource.data) || request.resource.data.clientEmail is string)
        && (!('clientName' in request.resource.data) || request.resource.data.clientName is string)
        && (!('clientPhone' in request.resource.data) || request.resource.data.clientPhone is string)
        && (!('linkedCustomerId' in request.resource.data) || request.resource.data.linkedCustomerId is string)
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy is string)
        && (!('projectName' in request.resource.data) || request.resource.data.projectName is string)
        && (!('clientType' in request.resource.data) || request.resource.data.clientType is string)
        && (!('primaryGenre' in request.resource.data) || request.resource.data.primaryGenre is string)
        && (!('mainNeed' in request.resource.data) || request.resource.data.mainNeed is string)
        && (!('memberCount' in request.resource.data) || request.resource.data.memberCount is string)
        && (!('preferredDuration' in request.resource.data) || request.resource.data.preferredDuration is string)
        && (!('preferredTime' in request.resource.data) || request.resource.data.preferredTime is string)
        && (!('preferredDays' in request.resource.data) || request.resource.data.preferredDays is string)
        && (!('socialLink' in request.resource.data) || request.resource.data.socialLink is string)
        && (!('gearNotes' in request.resource.data) || request.resource.data.gearNotes is string)
        && (!('invoiceName' in request.resource.data) || request.resource.data.invoiceName is string)
        && (!('paymentPreference' in request.resource.data) || request.resource.data.paymentPreference is string)
        && (!('clientLevel' in request.resource.data) || request.resource.data.clientLevel is string);

      allow update, delete: if hasPermission('calendar') || hasPermission('billing');
    }

    match /clientMessages/{messageId} {
      allow read: if isAdmin()
        || hasPermission('messages')
        || hasPermission('customers')
        || (
          signedInNonAnonymous()
          && resource.data.clientUid == request.auth.uid
        );

      allow create: if signedInNonAnonymous()
        && request.resource.data.keys().hasOnly([
          'id',
          'clientUid',
          'clientEmail',
          'clientName',
          'clientPhone',
          'linkedCustomerId',
          'message',
          'subject',
          'source',
          'status',
          'priority',
          'direction',
          'isReadByAdmin',
          'isReadByClient',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.id is string
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.subject is string
        && request.resource.data.status == 'open'
        && request.resource.data.priority in ['low', 'normal', 'high']
        && request.resource.data.direction == 'client_to_admin'
        && request.resource.data.isReadByAdmin == false
        && request.resource.data.isReadByClient == true
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (!('clientEmail' in request.resource.data) || request.resource.data.clientEmail is string)
        && (!('clientName' in request.resource.data) || request.resource.data.clientName is string)
        && (!('clientPhone' in request.resource.data) || request.resource.data.clientPhone is string)
        && (!('linkedCustomerId' in request.resource.data) || request.resource.data.linkedCustomerId is string)
        && (!('source' in request.resource.data) || request.resource.data.source is string);

      allow update: if isAdmin()
        || hasPermission('messages')
        || hasPermission('customers');

      allow delete: if isAdmin();
    }

    match /auditLogs/{document=**} {
      allow read: if isAdmin() || hasPermission('settings') || hasPermission('staff');
      allow create: if isStaffRole();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || hasPermission('staff') || isSelf(userId);

      allow create: if isAdmin()
        || (
          isSelf(userId)
          && selfUserCreateShape()
        );

      allow update: if isAdmin()
        || (
          isSelf(userId)
          && selfUserSafeUpdate()
        );

      allow delete: if isAdmin();
    }

    match /customers/{document=**} {
      allow read, write: if hasPermission('customers');
    }

    match /inventory/{document=**} {
      allow read, write: if hasPermission('inventory');
    }

    match /finances/{document=**} {
      allow read, write: if hasPermission('finance');
    }

    match /gallery/{document=**} {
      allow read: if true;
      allow write: if hasPermission('gallery');
    }

    match /albums/{document=**} {
      allow read: if true;
      allow write: if hasPermission('gallery');
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isAdmin() || isSelfUsernameMappingCreate();
      allow update: if isAdmin();
      allow delete: if isAdmin() || isSelfUsernameMappingDelete();
    }
  }
}

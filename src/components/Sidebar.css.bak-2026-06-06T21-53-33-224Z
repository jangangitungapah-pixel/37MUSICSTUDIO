      linear-gradient(180deg, rgba(255,255,255,0.96), rgba(255,255,255,0.84)),
      rgba(255,255,255,0.94) !important;
    border-color: rgba(20,23,32,0.085) !important;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.82),
      0 18px 44px rgba(20,23,32,0.12),
      0 0 0 1px rgba(20,23,32,0.04) !important;
  }

  [data-theme="light"] .bn-item {
    color: rgba(20,23,32,0.64) !important;
  }

  [data-theme="light"] .bn-icon-wrapper {
    background: rgba(20,23,32,0.045) !important;
  }

  [data-theme="light"] .bn-item.active {
    color: #ffffff !important;
  }
}

/* ════════════════════════════════════════════════════════════════════════════
   37 HIDE BOTTOM NAV ON MORE SHEET
   --------------------------------------------------------------------------
   Prevents the fixed/portaled mobile dock from overlapping the More menu sheet.
   ════════════════════════════════════════════════════════════════════════════ */

@media (max-width: 1024px) {
  body > .bottom-nav-bar.is-hidden-by-sheet,
  .bottom-nav-bar.is-hidden-by-sheet {
    opacity: 0 !important;
    transform: translate3d(0, 18px, 0) scale(0.96) !important;
    pointer-events: none !important;
    visibility: hidden !important;
    transition:
      opacity 140ms cubic-bezier(0.2, 0, 0, 1),
      transform 140ms cubic-bezier(0.2, 0, 0, 1),
      visibility 140ms cubic-bezier(0.2, 0, 0, 1) !important;
  }

  .mobile-bottom-sheet {
    padding-bottom: max(18px, env(safe-area-inset-bottom, 0px)) !important;
  }

  .mobile-bottom-sheet .modal-content,
  .mobile-bottom-sheet .modal-container,
  .mobile-bottom-sheet .modal-wrapper {
    padding-bottom: max(18px, env(safe-area-inset-bottom, 0px)) !important;
  }

  .bottom-sheet-grid {
    padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px)) !important;
  }

  .bottom-sheet-grid .sheet-nav-item:last-child {
    margin-bottom: 0 !important;
  }
}


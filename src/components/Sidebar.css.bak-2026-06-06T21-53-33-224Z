/* ════════════════════════════════════════════════════════════════════════════
   37 MOBILE HEADER SAFE OFFSET
   --------------------------------------------------------------------------
   Fixed mobile command header must never cover page content.
   This creates a single safe top offset for Dashboard, Calendar, and all
   admin pages after the spatial/mobile overrides.
   ════════════════════════════════════════════════════════════════════════════ */

:root {
  --mobile-command-top: calc(10px + env(safe-area-inset-top, 0px));
  --mobile-command-height: 70px;
  --mobile-command-gap: 16px;
  --mobile-command-clearance: calc(
    var(--mobile-command-top) +
    var(--mobile-command-height) +
    var(--mobile-command-gap)
  );
}

@media (max-width: 1024px) {
  .mobile-command-header {
    top: var(--mobile-command-top) !important;
    min-height: var(--mobile-command-height) !important;
    height: var(--mobile-command-height) !important;
    max-height: var(--mobile-command-height) !important;
  }

  .main-content {
    padding-top: var(--mobile-command-clearance) !important;
    scroll-padding-top: var(--mobile-command-clearance) !important;
  }

  .app-page,
  .dashboard-page,
  .calendar-page,
  .finance-page,
  .billing-page,
  .customers-page,
  .inventory-page,
  .staff-page,
  .settings-page,
  .gallery-page,
  .maintenance-page {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  .dashboard-page > :first-child,
  .calendar-page > :first-child,
  .finance-page > :first-child,
  .billing-page > :first-child,
  .customers-page > :first-child,
  .inventory-page > :first-child,
  .staff-page > :first-child,
  .settings-page > :first-child,
  .gallery-page > :first-child,
  .maintenance-page > :first-child {
    margin-top: 0 !important;
  }

  .mobile-command-header + *,
  .main-content > *:first-child {
    scroll-margin-top: var(--mobile-command-clearance) !important;
  }
}

@media (max-width: 480px) {
  :root {
    --mobile-command-height: 70px;
    --mobile-command-gap: 18px;
  }

  .main-content {
    padding-top: var(--mobile-command-clearance) !important;
  }
}

/* ════════════════════════════════════════════════════════════════════════════
   37 MOBILE BOTTOM NAV OVERHAUL
   --------------------------------------------------------------------------
   Floating dock navigation for mobile:
   clearer active state, safer spacing, better touch targets, premium depth.
   ════════════════════════════════════════════════════════════════════════════ */

:root {
  --mobile-bottom-dock-height: 76px;
  --mobile-bottom-dock-gap: 12px;
  --mobile-bottom-dock-radius: 28px;
  --mobile-bottom-clearance: calc(
    var(--mobile-bottom-dock-height) +
    var(--mobile-bottom-dock-gap) +
    env(safe-area-inset-bottom, 0px) +
    18px
  );
}

@media (max-width: 1024px) {
  .bottom-nav-bar {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    align-items: center !important;
    justify-items: stretch !important;

    position: fixed !important;
    left: max(12px, env(safe-area-inset-left, 0px)) !important;
    right: max(12px, env(safe-area-inset-right, 0px)) !important;
    bottom: calc(10px + env(safe-area-inset-bottom, 0px)) !important;
    width: auto !important;
    height: var(--mobile-bottom-dock-height) !important;
    min-height: var(--mobile-bottom-dock-height) !important;

    padding: 8px !important;
    border-radius: var(--mobile-bottom-dock-radius) !important;
    border: 1px solid rgba(255, 255, 255, 0.105) !important;

    background:
      radial-gradient(circle at 18% 0%, rgba(var(--accent-pink-rgb), 0.12), transparent 38%),
      radial-gradient(circle at 82% 0%, rgba(var(--accent-cyan-rgb), 0.08), transparent 36%),
      linear-gradient(180deg, rgba(255,255,255,0.072), rgba(255,255,255,0.022)),
      rgba(15, 18, 25, 0.88) !important;

    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.10),
      0 18px 46px rgba(0, 0, 0, 0.36),
      0 0 0 1px rgba(0, 0, 0, 0.16) !important;

    -webkit-backdrop-filter: blur(18px) saturate(1.12) !important;
    backdrop-filter: blur(18px) saturate(1.12) !important;

    z-index: 1200 !important;
    overflow: visible !important;
    isolation: isolate !important;
  }

  .bottom-nav-bar::before {
    content: "" !important;
    position: absolute !important;
    inset: 1px !important;
    border-radius: calc(var(--mobile-bottom-dock-radius) - 1px) !important;
    pointer-events: none !important;
    background:
      linear-gradient(135deg, rgba(255,255,255,0.055), transparent 34%),
      linear-gradient(315deg, rgba(var(--accent-cyan-rgb), 0.045), transparent 34%) !important;
    opacity: 0.65 !important;
    z-index: -1 !important;
  }

  .bn-item {
    position: relative !important;
    width: auto !important;
    height: 60px !important;
    min-width: 0 !important;

    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;

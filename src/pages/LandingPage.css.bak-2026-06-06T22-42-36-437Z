/* ════════════════════════════════════════════════════════════════════════════
   37 PREMIUM PORTAL LOGIN PANEL
   --------------------------------------------------------------------------
   Makes the landing login dropdown feel like a premium auth panel from a
   mature app: clean hierarchy, spatial depth, tactile fields, modern provider.
   ════════════════════════════════════════════════════════════════════════════ */

:root {
  --portal-login-radius: 28px;
  --portal-login-line: rgba(255,255,255,0.105);
  --portal-login-line-strong: rgba(255,255,255,0.155);
  --portal-login-surface: rgba(18, 22, 32, 0.935);
  --portal-login-surface-soft: rgba(255,255,255,0.046);
}

/* Main auth panel */
.nav-login-dropdown {
  position: absolute;
  right: 0;
  top: calc(100% + 14px);
  width: min(420px, calc(100vw - 28px));
  padding: 0;
  overflow: hidden;
  border-radius: var(--portal-login-radius);
  border: 1px solid var(--portal-login-line);
  background:
    radial-gradient(circle at 14% 0%, rgba(var(--accent-pink-rgb), 0.16), transparent 38%),
    radial-gradient(circle at 88% 0%, rgba(var(--accent-cyan-rgb), 0.105), transparent 34%),
    linear-gradient(180deg, rgba(255,255,255,0.078), rgba(255,255,255,0.018)),
    rgba(15, 18, 27, 0.965);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.12),
    0 28px 80px rgba(0,0,0,0.48),
    0 0 0 1px rgba(0,0,0,0.18);
  -webkit-backdrop-filter: blur(24px) saturate(1.12);
  backdrop-filter: blur(24px) saturate(1.12);
  isolation: isolate;
}

.nav-login-dropdown::before {
  content: "";
  position: absolute;
  inset: 1px;
  pointer-events: none;
  border-radius: calc(var(--portal-login-radius) - 1px);
  background:
    linear-gradient(135deg, rgba(255,255,255,0.085), transparent 34%),
    linear-gradient(315deg, rgba(var(--accent-cyan-rgb),0.045), transparent 32%);
  opacity: 0.78;
  z-index: 0;
}

.nav-login-dropdown > * {
  position: relative;
  z-index: 1;
}

/* Header/brand area inside dropdown */
.login-dropdown-header,
.login-dropdown-brand,
.login-dropdown-top {
  min-height: 76px;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 16px 17px;
  border-bottom: 1px solid rgba(255,255,255,0.075);
  background:
    linear-gradient(180deg, rgba(255,255,255,0.052), rgba(255,255,255,0.012)),
    rgba(255,255,255,0.020);
}

.login-dropdown-header img,
.login-dropdown-brand img,
.login-dropdown-logo img {
  width: 46px;
  height: 46px;
  object-fit: contain;
  border-radius: 14px;
}

.login-dropdown-logo,
.login-dropdown-mark {
  width: 48px;
  height: 48px;
  min-width: 48px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 0%, rgba(255,255,255,0.18), transparent 58%),
    rgba(255,255,255,0.055);
  border: 1px solid rgba(255,255,255,0.075);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.070),
    0 10px 24px rgba(0,0,0,0.16);
}

.login-dropdown-eyebrow,
.login-dropdown-subtitle,
.login-dropdown-header small {
  display: block;
  color: #f7c765;
  font-size: 0.68rem;
  line-height: 1;
  font-weight: 950;
  letter-spacing: 0.065em;
  text-transform: uppercase;
}

.login-dropdown-title {
  margin: 2px 0 0;
  color: #fff;
  font-size: 1.05rem;
  line-height: 1.05;
  font-weight: 950;
  letter-spacing: -0.045em;
}

/* Body spacing */
.login-dropdown-form,
.nav-login-dropdown form {
  display: grid;
  gap: 13px;
  padding: 16px 17px 17px;
}

/* Google provider button */
.login-google-btn {
  width: calc(100% - 34px);
  margin: 16px 17px 0;
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.11);
  color: #f7f8ff;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.070), rgba(255,255,255,0.018)),
    rgba(255,255,255,0.030);
  font: inherit;
  font-size: 0.86rem;
  font-weight: 950;
  cursor: pointer;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.080),
    0 12px 26px rgba(0,0,0,0.14);
  transition:
    transform 150ms cubic-bezier(0.2, 0, 0, 1),
    border-color 150ms cubic-bezier(0.2, 0, 0, 1),
    background-color 150ms cubic-bezier(0.2, 0, 0, 1),
    box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
}

.login-google-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  border-color: rgba(var(--accent-cyan-rgb),0.30);
  background:
    radial-gradient(circle at 50% 0%, rgba(var(--accent-cyan-rgb),0.105), transparent 64%),
    linear-gradient(180deg, rgba(255,255,255,0.086), rgba(255,255,255,0.022)),
    rgba(255,255,255,0.035);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.090),
    0 16px 32px rgba(0,0,0,0.18);
}

.login-google-btn:active {
  transform: scale(0.985);
}

.login-google-mark {
  width: 24px;
  height: 24px;
  min-width: 24px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  color: #111827;
  background:
    radial-gradient(circle at 50% 0%, #ffffff, #e9edf5);
  font-size: 0.88rem;
  font-weight: 950;
  box-shadow: 0 7px 16px rgba(0,0,0,0.18);
}

/* Divider */
.login-dropdown-or {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 13px 17px 0;
  color: rgba(226,232,245,0.50);
  font-size: 0.64rem;
  font-weight: 950;
  letter-spacing: 0.075em;
  text-transform: uppercase;
}

.login-dropdown-or::before,
.login-dropdown-or::after {
  content: "";
  flex: 1;
  height: 1px;
  background:
    linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
}

/* Fields */
.login-field {
  display: grid;
  gap: 7px;
}

.login-field-label {
  color: rgba(226,232,245,0.78);
  font-size: 0.76rem;
  font-weight: 900;
  letter-spacing: -0.01em;
}

.login-field-wrap {
  min-height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 13px;
  border-radius: 17px;
  border: 1px solid rgba(255,255,255,0.09);
  background:
    linear-gradient(180deg, rgba(255,255,255,0.046), rgba(255,255,255,0.010)),
    rgba(10, 13, 20, 0.76);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.042),
    inset 0 -1px 0 rgba(0,0,0,0.20);
  transition:
    border-color 150ms cubic-bezier(0.2, 0, 0, 1),
    box-shadow 150ms cubic-bezier(0.2, 0, 0, 1),
    background-color 150ms cubic-bezier(0.2, 0, 0, 1);
}

.login-field-wrap:focus-within {
  border-color: rgba(var(--accent-cyan-rgb),0.55);
  background:
    radial-gradient(circle at 50% 0%, rgba(var(--accent-cyan-rgb),0.070), transparent 68%),
    linear-gradient(180deg, rgba(255,255,255,0.058), rgba(255,255,255,0.014)),
    rgba(11, 15, 23, 0.92);
  box-shadow:
    0 0 0 3px rgba(var(--accent-cyan-rgb),0.14),
    inset 0 1px 0 rgba(255,255,255,0.055);
}

.login-field-icon {
  color: rgba(226,232,245,0.48);
}

.login-field-input {
  min-width: 0;
  flex: 1;
  height: 100%;
  border: 0;
  outline: 0;
  color: #fff;
  background: transparent;
  font: inherit;
  font-size: 0.92rem;
  font-weight: 800;
}

.login-field-input::placeholder {
  color: rgba(226,232,245,0.34);
}

.login-field-toggle {
  width: 32px;
  height: 32px;
  border: 0;
  border-radius: 12px;
  display: grid;
  place-items: center;
  color: rgba(226,232,245,0.58);
  background: rgba(255,255,255,0.030);
  cursor: pointer;
}

.login-field-toggle:hover {
  color: #fff;
  background: rgba(255,255,255,0.055);
}

/* Error */
.login-error,
.login-dropdown-error {
  margin: 0 17px;
  border-radius: 16px;
  border: 1px solid rgba(var(--accent-pink-rgb),0.18);
  background: rgba(var(--accent-pink-rgb),0.09);
  color: #ff7a96;
}

/* Submit */
.login-dropdown-submit {
  min-height: 50px;
  border-radius: 17px;
  border: 0;
  color: #fff;
  background:
    radial-gradient(circle at 50% 0%, rgba(255,255,255,0.20), transparent 58%),
    linear-gradient(135deg, rgba(var(--accent-pink-rgb),0.98), rgba(var(--accent-pink-rgb),0.76));
  font: inherit;
  font-size: 0.92rem;
  font-weight: 950;
  letter-spacing: -0.025em;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.19),
    0 16px 34px rgba(var(--accent-pink-rgb),0.26);
  transition:
    transform 150ms cubic-bezier(0.2, 0, 0, 1),
    box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
}

.login-dropdown-submit:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.22),
    0 20px 42px rgba(var(--accent-pink-rgb),0.31);
}

.login-dropdown-submit:active {
  transform: scale(0.985);
}

/* Register row */
.login-dropdown-client-row {
  margin: 0 17px 17px;
  min-height: 44px;
  padding: 10px 12px;
  border-radius: 17px;
  color: rgba(226,232,245,0.58);
  font-size: 0.78rem;
  font-weight: 800;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.042), rgba(255,255,255,0.010)),
    rgba(255,255,255,0.018);
  border: 1px solid rgba(255,255,255,0.075);
}

.login-dropdown-client-row a {
  color: var(--accent-cyan);
  font-weight: 950;
  text-decoration: none;
}

/* Mobile: make it feel like an app auth sheet, not a pasted form */
@media (max-width: 768px) {
  .nav-login-dropdown {
    position: fixed;
    left: 10px;
    right: 10px;
    top: 72px;
    width: auto;
    max-height: calc(100svh - 92px);
    overflow-y: auto;
    border-radius: 26px;
  }

  .login-dropdown-header,
  .login-dropdown-brand,
  .login-dropdown-top {
    min-height: 70px;
    padding: 14px 15px;
  }

  .login-dropdown-logo,
  .login-dropdown-mark {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 15px;
  }

  .login-dropdown-title {
    font-size: 1rem;
  }

  .login-google-btn {
    width: calc(100% - 30px);
    margin: 14px 15px 0;
    min-height: 46px;
    font-size: 0.82rem;
  }

  .login-dropdown-or {
    margin-inline: 15px;
    font-size: 0.60rem;
  }

  .login-dropdown-form,
  .nav-login-dropdown form {
    padding: 14px 15px 15px;
    gap: 12px;
  }

  .login-field-wrap {
    min-height: 47px;
    border-radius: 16px;
  }

  .login-dropdown-submit {
    min-height: 49px;
    border-radius: 16px;
  }

  .login-dropdown-client-row {
    margin: 0 15px 15px;
    align-items: center;
    flex-direction: row;
  }
}

@media (max-width: 420px) {
  .nav-login-dropdown {
    left: 8px;
    right: 8px;
    top: 70px;
    border-radius: 24px;
  }

  .login-google-btn {
    font-size: 0.78rem;
    gap: 8px;
  }

  .login-google-mark {
    width: 22px;
    height: 22px;
    min-width: 22px;
  }

  .login-field-label {
    font-size: 0.72rem;
  }

  .login-field-input {
    font-size: 0.88rem;
  }
}

/* Light mode */
[data-theme="light"] .nav-login-dropdown {
  --portal-login-line: rgba(20,23,32,0.090);
  --portal-login-line-strong: rgba(20,23,32,0.14);
  background:
    radial-gradient(circle at 14% 0%, rgba(var(--accent-pink-rgb), 0.075), transparent 38%),
    radial-gradient(circle at 88% 0%, rgba(var(--accent-cyan-rgb), 0.055), transparent 34%),
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,249,252,0.90)),
    rgba(255,255,255,0.96);
  border-color: rgba(20,23,32,0.09);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.86),
    0 28px 80px rgba(20,23,32,0.14),
    0 0 0 1px rgba(20,23,32,0.04);
}

[data-theme="light"] .login-dropdown-title,
[data-theme="light"] .login-field-input {
  color: #141722;
}

[data-theme="light"] .login-field-label {
  color: rgba(20,23,32,0.72);
}

[data-theme="light"] .login-field-wrap,
[data-theme="light"] .login-google-btn,
[data-theme="light"] .login-dropdown-client-row {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,249,252,0.82)),
    rgba(255,255,255,0.92);
  border-color: rgba(20,23,32,0.085);
}

[data-theme="light"] .login-dropdown-or::before,
[data-theme="light"] .login-dropdown-or::after {
  background: rgba(20,23,32,0.10);
}

/* ════════════════════════════════════════════════════════════════════════════
   37 AUTH PANEL REAL APP POLISH
   --------------------------------------------------------------------------
   Final auth-panel polish for the client landing:
   - removes header artifact
   - makes inputs single-shell
   - improves Google button/divider hierarchy
   - reduces visual heaviness
   - fixes mobile proportions and spacing
   ════════════════════════════════════════════════════════════════════════════ */

:root {
  --auth-panel-radius: 26px;
  --auth-panel-field-radius: 16px;
  --auth-panel-line: rgba(255,255,255,0.085);
  --auth-panel-line-strong: rgba(255,255,255,0.135);
  --auth-panel-text-soft: rgba(234, 238, 248, 0.70);
  --auth-panel-text-muted: rgba(234, 238, 248, 0.48);
}

/* ─── Panel shell: more app-like, less dropdown-like ─── */
.nav-login-dropdown {
  width: min(392px, calc(100vw - 28px)) !important;
  padding: 0 !important;
  border-radius: var(--auth-panel-radius) !important;
  border: 1px solid var(--auth-panel-line) !important;
  background:
    radial-gradient(circle at 18% 0%, rgba(var(--accent-pink-rgb), 0.105), transparent 38%) !important,
    radial-gradient(circle at 86% 3%, rgba(var(--accent-cyan-rgb), 0.075), transparent 34%) !important,
    linear-gradient(180deg, rgba(255,255,255,0.060), rgba(255,255,255,0.014)) !important,
    rgba(16, 20, 30, 0.965) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.090),
    0 22px 58px rgba(0,0,0,0.40),
    0 0 0 1px rgba(0,0,0,0.16) !important;
  overflow: hidden !important;
  isolation: isolate !important;
  -webkit-backdrop-filter: blur(22px) saturate(1.10) !important;
  backdrop-filter: blur(22px) saturate(1.10) !important;
}

.nav-login-dropdown::before {
  content: "" !important;
  position: absolute !important;
  inset: 1px !important;
  border-radius: calc(var(--auth-panel-radius) - 1px) !important;
  pointer-events: none !important;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.060), transparent 32%),
    linear-gradient(315deg, rgba(var(--accent-cyan-rgb),0.030), transparent 32%) !important;
  opacity: 0.72 !important;
  z-index: 0 !important;
}

.nav-login-dropdown > * {
  position: relative !important;
  z-index: 1 !important;
}

/* ─── Header fix: kill the accidental grey block/artifact ─── */
.login-dropdown-header {
  min-height: 84px !important;
  display: flex !important;
  align-items: center !important;
  gap: 13px !important;
  padding: 16px !important;
  border-bottom: 1px solid rgba(255,255,255,0.060) !important;
  background:
    radial-gradient(circle at 12% 0%, rgba(var(--accent-pink-rgb),0.070), transparent 52%),
    linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.010)),
    rgba(255,255,255,0.010) !important;
}

.login-dropdown-icon-wrap {
  width: 52px !important;
  height: 52px !important;
  min-width: 52px !important;
  display: grid !important;
  place-items: center !important;
  overflow: hidden !important;
  border-radius: 17px !important;
  background:
    radial-gradient(circle at 50% 0%, rgba(255,255,255,0.12), transparent 58%),
    rgba(255,255,255,0.045) !important;
  border: 1px solid rgba(255,255,255,0.070) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.055),
    0 10px 22px rgba(0,0,0,0.14) !important;
}

.login-dropdown-icon-wrap img {
  width: 38px !important;
  height: 38px !important;
  object-fit: contain !important;
  transform: none !important;
  filter: drop-shadow(0 7px 14px rgba(0,0,0,0.22)) !important;
}

/* This fixes the grey rectangle behind "37 MUSIC STUDIO" */
.login-dropdown-brand {
  display: block !important;
  min-height: 0 !important;
  margin: 0 0 5px !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  color: #f7c765 !important;
  font-size: 0.66rem !important;
  line-height: 1 !important;
  font-weight: 950 !important;
  letter-spacing: 0.070em !important;
  text-transform: uppercase !important;
}

.login-dropdown-title {
  display: block !important;
  margin: 0 !important;
  padding: 0 !important;
  color: #fff !important;
  font-size: 1.06rem !important;
  line-height: 1.05 !important;
  font-weight: 950 !important;
  letter-spacing: -0.045em !important;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

/* ─── Google provider: mature secondary action ─── */
.login-google-btn {
  width: calc(100% - 32px) !important;
  min-height: 46px !important;
  margin: 15px 16px 0 !important;
  padding: 0 15px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 10px !important;
  border-radius: 999px !important;
  border: 1px solid rgba(255,255,255,0.095) !important;
  color: rgba(248,250,255,0.94) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.052), rgba(255,255,255,0.012)),
    rgba(255,255,255,0.022) !important;
  font: inherit !important;
  font-size: 0.82rem !important;
  line-height: 1 !important;
  font-weight: 900 !important;
  letter-spacing: -0.020em !important;
  cursor: pointer !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.060),
    0 8px 20px rgba(0,0,0,0.10) !important;
}

.login-google-btn:hover:not(:disabled) {
  transform: translateY(-1px) !important;
  border-color: rgba(var(--accent-cyan-rgb),0.22) !important;
  background:
    radial-gradient(circle at 50% 0%, rgba(var(--accent-cyan-rgb),0.075), transparent 66%),
    linear-gradient(180deg, rgba(255,255,255,0.064), rgba(255,255,255,0.014)),
    rgba(255,255,255,0.026) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.070),
    0 12px 26px rgba(0,0,0,0.13) !important;
}

.login-google-mark {
  width: 22px !important;
  height: 22px !important;
  min-width: 22px !important;
  display: grid !important;
  place-items: center !important;
  border-radius: 999px !important;
  color: #111827 !important;
  background:
    radial-gradient(circle at 50% 0%, #fff, #eef1f6) !important;
  font-size: 0.82rem !important;
  font-weight: 950 !important;
  box-shadow: 0 5px 12px rgba(0,0,0,0.15) !important;
}

/* ─── Divider: less visual noise ─── */
.login-dropdown-or {
  margin: 12px 16px 0 !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  color: rgba(234,238,248,0.36) !important;
  font-size: 0.58rem !important;
  line-height: 1 !important;
  font-weight: 950 !important;
  letter-spacing: 0.085em !important;
  text-transform: uppercase !important;
}

.login-dropdown-or::before,
.login-dropdown-or::after {
  content: "" !important;
  flex: 1 !important;
  height: 1px !important;
  background:
    linear-gradient(90deg, transparent, rgba(255,255,255,0.085), transparent) !important;
}

/* ─── Form area: calmer spacing ─── */
.login-dropdown-form,
.nav-login-dropdown form {
  display: grid !important;
  gap: 12px !important;
  padding: 14px 16px 16px !important;
  background: transparent !important;
}

.login-field {
  display: grid !important;
  gap: 7px !important;
}

.login-field-label {
  color: rgba(232,237,248,0.68) !important;
  font-size: 0.72rem !important;
  line-height: 1 !important;
  font-weight: 850 !important;
  letter-spacing: -0.005em !important;
}

/* ─── Input single-shell: fixes double-layer look ─── */
.login-field-wrap {
  position: relative !important;
  min-height: 46px !important;
  display: flex !important;
  align-items: center !important;
  gap: 9px !important;
  padding: 0 12px !important;
  border-radius: var(--auth-panel-field-radius) !important;
  border: 1px solid rgba(255,255,255,0.082) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.034), rgba(255,255,255,0.006)),
    rgba(7, 10, 16, 0.56) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.032),
    inset 0 -1px 0 rgba(0,0,0,0.16) !important;
  overflow: hidden !important;
}

.login-field-wrap:focus-within {
  border-color: rgba(var(--accent-cyan-rgb),0.36) !important;
  background:
    radial-gradient(circle at 50% 0%, rgba(var(--accent-cyan-rgb),0.052), transparent 70%),
    linear-gradient(180deg, rgba(255,255,255,0.044), rgba(255,255,255,0.010)),
    rgba(9, 13, 20, 0.78) !important;
  box-shadow:
    0 0 0 2px rgba(var(--accent-cyan-rgb),0.105),
    inset 0 1px 0 rgba(255,255,255,0.044) !important;
}

.login-field-icon {
  position: static !important;
  left: auto !important;
  flex: 0 0 auto !important;
  width: 16px !important;
  height: 16px !important;
  color: rgba(232,237,248,0.42) !important;
  pointer-events: none !important;
}

.login-field-input {
  width: auto !important;
  min-width: 0 !important;
  flex: 1 1 auto !important;
  min-height: 44px !important;
  height: 44px !important;
  padding: 0 !important;
  border: 0 !important;
  outline: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  color: rgba(255,255,255,0.96) !important;
  font: inherit !important;
  font-size: 0.88rem !important;
  font-weight: 820 !important;
  box-shadow: none !important;
}

.login-field-input:focus {
  border: 0 !important;
  box-shadow: none !important;
  background: transparent !important;
}

.login-field-input::placeholder {
  color: rgba(232,237,248,0.30) !important;
}

.login-field-toggle {
  position: static !important;
  right: auto !important;
  flex: 0 0 auto !important;
  width: 31px !important;
  height: 31px !important;
  display: grid !important;
  place-items: center !important;
  border: 0 !important;
  border-radius: 12px !important;
  color: rgba(232,237,248,0.44) !important;
  background: rgba(255,255,255,0.032) !important;
  cursor: pointer !important;
}

.login-field-toggle:hover {
  color: rgba(255,255,255,0.90) !important;
  background: rgba(255,255,255,0.060) !important;
}

/* ─── Error: make it fit the system ─── */
.login-dropdown-error,
.login-error {
  margin: 0 !important;
  padding: 10px 11px !important;
  border-radius: 14px !important;
  border: 1px solid rgba(var(--accent-pink-rgb),0.20) !important;
  color: #ff7c98 !important;
  background: rgba(var(--accent-pink-rgb),0.085) !important;
  font-size: 0.78rem !important;
  font-weight: 800 !important;
}

/* ─── Primary CTA: strong but not screaming ─── */
.login-dropdown-submit {
  min-height: 48px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 9px !important;
  border: 0 !important;
  border-radius: 16px !important;
  color: #fff !important;
  background:
    radial-gradient(circle at 50% 0%, rgba(255,255,255,0.18), transparent 58%),
    linear-gradient(135deg, rgba(var(--accent-pink-rgb),0.96), rgba(var(--accent-pink-rgb),0.72)) !important;
  font: inherit !important;
  font-size: 0.88rem !important;
  font-weight: 950 !important;
  letter-spacing: -0.025em !important;
  cursor: pointer !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.17),
    0 12px 28px rgba(var(--accent-pink-rgb),0.22) !important;
}

.login-dropdown-submit:hover:not(:disabled) {
  transform: translateY(-1px) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.20),
    0 16px 34px rgba(var(--accent-pink-rgb),0.27) !important;
}

.login-dropdown-submit:disabled {
  opacity: 0.68 !important;
  cursor: not-allowed !important;
}

/* ─── Register row: optional, calm footer ─── */
.login-dropdown-client-row {
  min-height: 42px !important;
  margin: 0 16px 16px !important;
  padding: 10px 11px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 8px !important;
  border-radius: 15px !important;
  color: rgba(232,237,248,0.52) !important;
  font-size: 0.74rem !important;
  font-weight: 780 !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.030), rgba(255,255,255,0.006)),
    rgba(255,255,255,0.012) !important;
  border: 1px solid rgba(255,255,255,0.058) !important;
  box-shadow: none !important;
}

.login-dropdown-client-row a {
  color: var(--accent-cyan) !important;
  text-decoration: none !important;
  font-weight: 920 !important;
}

/* ─── Reduce visual collision with hero session below ─── */
.nav-login-dropdown + .hero-section,
.landing-nav + .nav-login-dropdown + .hero-section {
  margin-top: 0 !important;
}

.hero-session {
  border-radius: 16px !important;
}

.hero-session-grid div {
  border-radius: 14px !important;
}

/* ─── Mobile: auth sheet proportions ─── */
@media (max-width: 768px) {
  .nav-login-dropdown {
    left: 14px !important;
    right: 14px !important;
    top: calc(72px + env(safe-area-inset-top, 0px)) !important;
    width: auto !important;
    max-height: calc(100svh - 92px - env(safe-area-inset-top, 0px)) !important;
    overflow-y: auto !important;
    border-radius: 24px !important;
  }

  .login-dropdown-header {
    min-height: 74px !important;
    padding: 14px !important;
  }

  .login-dropdown-icon-wrap {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    border-radius: 16px !important;
  }

  .login-dropdown-icon-wrap img {
    width: 35px !important;
    height: 35px !important;
  }

  .login-dropdown-brand {
    font-size: 0.61rem !important;
  }

  .login-dropdown-title {
    font-size: 1rem !important;
  }

  .login-google-btn {
    width: calc(100% - 28px) !important;
    min-height: 45px !important;
    margin: 14px 14px 0 !important;
    font-size: 0.78rem !important;
  }

  .login-dropdown-or {
    margin: 11px 14px 0 !important;
    font-size: 0.56rem !important;
  }

  .login-dropdown-form,
  .nav-login-dropdown form {
    padding: 13px 14px 14px !important;
    gap: 11px !important;
  }

  .login-field-label {
    font-size: 0.70rem !important;
  }

  .login-field-wrap {
    min-height: 45px !important;
    border-radius: 15px !important;
  }

  .login-field-input {
    min-height: 43px !important;
    height: 43px !important;
    font-size: 0.86rem !important;
  }

  .login-dropdown-submit {
    min-height: 47px !important;
    border-radius: 15px !important;
    font-size: 0.86rem !important;
  }

  .login-dropdown-client-row {
    margin: 0 14px 14px !important;
    min-height: 40px !important;
  }

  .hero-session {
    margin-top: 12px !important;
  }
}

@media (max-width: 420px) {
  .nav-login-dropdown {
    left: 10px !important;
    right: 10px !important;
    top: calc(68px + env(safe-area-inset-top, 0px)) !important;
    border-radius: 22px !important;
  }

  .login-dropdown-header {
    min-height: 70px !important;
    padding: 13px !important;
  }

  .login-dropdown-icon-wrap {
    width: 46px !important;
    height: 46px !important;
    min-width: 46px !important;
  }

  .login-google-btn {
    width: calc(100% - 26px) !important;
    margin-inline: 13px !important;
    padding-inline: 12px !important;
    font-size: 0.74rem !important;
    gap: 8px !important;
  }

  .login-google-mark {
    width: 21px !important;
    height: 21px !important;
    min-width: 21px !important;
  }

  .login-dropdown-or {
    margin-inline: 13px !important;
    gap: 8px !important;
  }

  .login-dropdown-form,
  .nav-login-dropdown form {
    padding-inline: 13px !important;
  }

  .login-dropdown-client-row {
    margin-inline: 13px !important;
  }
}

/* ─── Light mode ─── */
[data-theme="light"] .nav-login-dropdown {
  --auth-panel-line: rgba(20,23,32,0.082);
  --auth-panel-line-strong: rgba(20,23,32,0.13);
  background:
    radial-gradient(circle at 18% 0%, rgba(var(--accent-pink-rgb), 0.060), transparent 38%),
    radial-gradient(circle at 86% 3%, rgba(var(--accent-cyan-rgb), 0.050), transparent 34%),
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,249,252,0.90)),
    rgba(255,255,255,0.96) !important;
  border-color: rgba(20,23,32,0.085) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.86),
    0 22px 58px rgba(20,23,32,0.13),
    0 0 0 1px rgba(20,23,32,0.035) !important;
}

[data-theme="light"] .login-dropdown-header,
[data-theme="light"] .login-field-wrap,
[data-theme="light"] .login-google-btn,
[data-theme="light"] .login-dropdown-client-row {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,249,252,0.84)),
    rgba(255,255,255,0.92) !important;
  border-color: rgba(20,23,32,0.080) !important;
}

[data-theme="light"] .login-dropdown-title,
[data-theme="light"] .login-field-input {
  color: #141722 !important;
}

[data-theme="light"] .login-dropdown-brand {
  color: #bd822f !important;
}

[data-theme="light"] .login-field-label {
  color: rgba(20,23,32,0.68) !important;
}

[data-theme="light"] .login-dropdown-or {
  color: rgba(20,23,32,0.40) !important;
}

[data-theme="light"] .login-dropdown-or::before,
[data-theme="light"] .login-dropdown-or::after {
  background:
    linear-gradient(90deg, transparent, rgba(20,23,32,0.10), transparent) !important;
}


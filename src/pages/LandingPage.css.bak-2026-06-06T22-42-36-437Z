[data-theme="light"] .landing-container {
  --landing-bg: #f7f3ea;
  --landing-surface: rgba(255, 255, 255, 0.78);
  --landing-surface-strong: rgba(255, 255, 255, 0.92);
  --landing-line: rgba(30, 25, 18, 0.12);
  --landing-line-strong: rgba(30, 25, 18, 0.22);
  --landing-text: #1a1510;
  --landing-muted: #655b4e;
  --landing-soft: #817769;
  --landing-gold: #a86b1f;
  --landing-rose: #d52d56;
  --landing-cyan: #087987;
  --landing-green: #267447;
  --landing-shadow: 0 24px 70px rgba(38, 30, 18, 0.12);

  background:
    linear-gradient(180deg, #f7f3ea 0%, #fffaf1 46%, #f1eadf 100%);
}

[data-theme="light"] .landing-container::before {
  background:
    linear-gradient(rgba(30, 25, 18, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(30, 25, 18, 0.03) 1px, transparent 1px);
}

[data-theme="light"] .landing-nav.scrolled,
[data-theme="light"] .nav-login-dropdown,
[data-theme="light"] .mobile-nav-menu {
  background: rgba(255, 250, 241, 0.9);
}

/* Light Theme Navigation Bar (Unscrolled vs Scrolled) */
[data-theme="light"] .landing-nav:not(.scrolled) .brand-text {
  color: #fffaf0 !important;
}

[data-theme="light"] .landing-nav:not(.scrolled) .nav-links a {
  color: rgba(255, 250, 240, 0.78) !important;
}

[data-theme="light"] .landing-nav:not(.scrolled) .nav-links a:hover {
  color: #fffaf0 !important;
}

[data-theme="light"] .landing-nav:not(.scrolled) .nav-theme-btn,
[data-theme="light"] .landing-nav:not(.scrolled) .nav-login-btn,
[data-theme="light"] .landing-nav:not(.scrolled) .nav-hamburger {
  background: rgba(255, 255, 255, 0.055) !important;
  color: #fffaf0 !important;
  border-color: rgba(255, 255, 255, 0.11) !important;
}

[data-theme="light"] .landing-nav.scrolled .brand-text {
  color: var(--landing-text) !important;
}

[data-theme="light"] .landing-nav.scrolled .nav-links a {
  color: rgba(26, 21, 16, 0.72) !important;
}

[data-theme="light"] .landing-nav.scrolled .nav-links a:hover {
  color: var(--landing-text) !important;
}

[data-theme="light"] .landing-nav.scrolled .nav-theme-btn,
[data-theme="light"] .landing-nav.scrolled .nav-login-btn,
[data-theme="light"] .landing-nav.scrolled .nav-hamburger {
  background: rgba(0, 0, 0, 0.035) !important;
  color: var(--landing-text) !important;
  border-color: rgba(30, 25, 18, 0.12) !important;
}

[data-theme="light"] .landing-nav.scrolled .nav-theme-btn:hover,
[data-theme="light"] .landing-nav.scrolled .nav-login-btn:hover,
[data-theme="light"] .landing-nav.scrolled .nav-login-btn.active,
[data-theme="light"] .landing-nav.scrolled .nav-hamburger:hover,
[data-theme="light"] .landing-nav.scrolled .nav-hamburger.open {
  border-color: rgba(168, 107, 31, 0.52) !important;
  color: var(--landing-gold) !important;
  background: rgba(168, 107, 31, 0.1) !important;
}

[data-theme="light"] .nav-brand-mark {
  background: rgba(255, 255, 255, 0.62);
}

[data-theme="light"] .hero-title,
[data-theme="light"] .hero-subtitle,
[data-theme="light"] .hero-session-main strong,
[data-theme="light"] .hero-session-grid div,
[data-theme="light"] .landing-container .hero-section .btn-secondary.btn-large {
  color: #fffaf0;
}

[data-theme="light"] .hero-session {
  background: rgba(8, 8, 7, 0.58);

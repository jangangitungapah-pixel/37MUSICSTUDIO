/* ════════════════════════════════════════════════════════════════════════════
   37 SPATIAL LITE UI — PHASE 1
   --------------------------------------------------------------------------
   Lightweight spatial depth + subtle ambient surfaces.
   Goal: premium depth without heavy glass blur, neon overload, or mobile lag.
   ════════════════════════════════════════════════════════════════════════════ */

:root {
  --spatial-page-pad: clamp(16px, 2vw, 28px);
  --spatial-section-gap: clamp(16px, 2vw, 26px);

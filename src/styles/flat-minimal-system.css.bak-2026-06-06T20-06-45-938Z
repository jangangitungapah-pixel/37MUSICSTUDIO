  margin-top: 6px !important;
  color: var(--text-secondary) !important;
  font-weight: 700 !important;
}

/* Live clock */
.dash-live-clock-widget {
  min-width: 190px !important;
  padding: 14px 16px !important;
  border-radius: 20px !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018)),
    rgba(var(--bg-surface-rgb), 0.58) !important;
  border: 1px solid var(--border-subtle) !important;
  box-shadow: var(--depth-line), var(--depth-1) !important;
}

.clock-time {
  font-size: clamp(1.65rem, 2.2vw, 2.3rem) !important;
  font-weight: 900 !important;
  letter-spacing: -0.06em !important;
  line-height: 1 !important;
}

.clock-details {
  margin-top: 6px !important;
  display: grid !important;
  gap: 4px !important;
  color: var(--text-muted) !important;
  font-size: 0.78rem !important;
}

.clock-status-live {
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  color: var(--accent-cyan) !important;
  font-weight: 800 !important;
}

/* Alert strip */
.dash-alerts-strip {
  display: flex !important;
  flex-wrap: wrap !important;
  justify-content: flex-end !important;
  gap: 8px !important;
}

.dash-alert-chip {
  min-height: 34px !important;
  padding: 8px 11px !important;
  border-radius: 999px !important;
  font-size: 0.78rem !important;
  font-weight: 800 !important;
  line-height: 1 !important;
  background: rgba(var(--bg-surface-rgb), 0.55) !important;
  box-shadow: var(--depth-line) !important;
}

.dash-alert-chip.warning {
  color: rgb(var(--warning-rgb)) !important;
  border-color: rgba(var(--warning-rgb), 0.24) !important;
  background: rgba(var(--warning-rgb), 0.09) !important;
}

.dash-alert-chip.danger {
  color: rgb(var(--danger-rgb)) !important;
  border-color: rgba(var(--danger-rgb), 0.24) !important;
  background: rgba(var(--danger-rgb), 0.09) !important;
}

.dash-alert-chip.info {
  color: var(--accent-cyan) !important;
  border-color: rgba(var(--accent-cyan-rgb), 0.22) !important;
  background: rgba(var(--accent-cyan-rgb), 0.08) !important;
}

.dash-alert-chip.success {
  color: rgb(var(--success-rgb)) !important;
  border-color: rgba(var(--success-rgb), 0.22) !important;
  background: rgba(var(--success-rgb), 0.08) !important;
}

/* Dashboard action toolbar */
.dash-action-toolbar {
  display: flex !important;
  flex-wrap: wrap !important;
  justify-content: flex-end !important;
  align-items: center !important;
  gap: 8px !important;
}

.dash-action-toolbar .btn-primary,
.dash-action-toolbar .btn-secondary,
.dash-action-toolbar button {
  min-height: 40px !important;
  padding-inline: 13px !important;
  border-radius: 999px !important;
  font-weight: 850 !important;
  white-space: nowrap !important;
}

/* Stat grid polish */
.dash-stat-card,
.app-stat-card,
.stat-card {
  min-height: 126px !important;
  padding: clamp(16px, 1.7vw, 22px) !important;
  border-radius: 24px !important;
}

.dash-stat-card h3,
.app-stat-card h3,
.stat-card h3 {
  color: var(--text-secondary) !important;
  font-size: 0.78rem !important;
  font-weight: 850 !important;
  letter-spacing: 0.02em !important;
  text-transform: uppercase !important;
}

.dash-stat-card .stat-value,
.app-stat-card .stat-value,
.stat-card .stat-value,
.dash-stat-value {
  font-size: clamp(1.5rem, 2.2vw, 2.25rem) !important;
  font-weight: 950 !important;
  letter-spacing: -0.06em !important;
  line-height: 1.05 !important;
}

/* Chart and smart panels */
.dash-chart-card,
.dash-smart-card {
  border-radius: 26px !important;
  padding: clamp(16px, 1.8vw, 22px) !important;
}

.dash-chart-card .card-header,
.dash-smart-card .card-header,
.app-panel .card-header {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 12px !important;
  padding-bottom: 12px !important;
  border-bottom: 1px solid var(--border-subtle) !important;
}

.dash-chart-card h3,
.dash-smart-card h3,
.app-panel h3 {
  letter-spacing: -0.025em !important;
}

/* Work list / request list */
.dash-work-item,
.dash-slot-item,
.upcoming-item,
.top-cust-row {
  border-radius: 16px !important;
  padding: 12px 13px !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01)),
    var(--surface-2) !important;
  box-shadow: var(--depth-line) !important;
}

.dash-work-item + .dash-work-item,
.dash-slot-item + .dash-slot-item,
.upcoming-item + .upcoming-item,
.top-cust-row + .top-cust-row {
  margin-top: 8px !important;
}

/* Sidebar spatial navigation */
.sidebar {
  border-right: 1px solid var(--border-subtle) !important;
  background:
    radial-gradient(circle at 0% 0%, rgba(var(--accent-pink-rgb), 0.10), transparent 28rem),
    linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.01)),
    rgba(var(--bg-surface-rgb), 0.94) !important;
}

.sidebar-header,
.sidebar-footer,
.sidebar-profile,
.nav-brand,
.nav-user-card {
  position: relative !important;
}

.nav-brand-mark,
.pc-brand-mark,
.auth-header-logo {
  border-radius: 16px !important;
  box-shadow: var(--depth-line), 0 8px 20px rgba(var(--accent-pink-rgb), 0.10) !important;
}

.nav-item,
.settings-nav-item,
.mobile-nav-item,
.bottom-nav-item {
  position: relative !important;
  min-height: 42px !important;
  border-radius: 15px !important;
  transition:
    background-color var(--durationFast) var(--curveEasyEase),
    color var(--durationFast) var(--curveEasyEase),
    transform var(--durationFast) var(--curveEasyEase),
    border-color var(--durationFast) var(--curveEasyEase) !important;
}

.nav-item.active,
.settings-nav-item.active,
.mobile-nav-item.active,
.bottom-nav-item.active {
  background:
    linear-gradient(90deg, rgba(var(--accent-pink-rgb), 0.17), rgba(var(--accent-cyan-rgb), 0.055)),
    var(--surface-2) !important;
  color: var(--text-primary) !important;
  border-color: rgba(var(--accent-pink-rgb), 0.25) !important;
  box-shadow: var(--depth-line), 0 8px 18px rgba(var(--accent-pink-rgb), 0.08) !important;
}

.nav-item.active::before,
.settings-nav-item.active::before {
  content: "" !important;
  position: absolute !important;
  left: 7px !important;
  top: 50% !important;
  width: 4px !important;
  height: 18px !important;
  transform: translateY(-50%) !important;
  border-radius: 999px !important;
  background: var(--accent-pink) !important;
  box-shadow: 0 0 16px rgba(var(--accent-pink-rgb), 0.38) !important;
}

.nav-item.active .nav-icon,
.settings-nav-item.active .nav-icon,
.mobile-nav-item.active .nav-icon,
.bottom-nav-item.active .nav-icon {
  color: var(--accent-pink) !important;
  background: rgba(var(--accent-pink-rgb), 0.11) !important;
  border-color: rgba(var(--accent-pink-rgb), 0.22) !important;
}

/* Bottom mobile nav */
.bottom-nav-bar {
  min-height: calc(66px + env(safe-area-inset-bottom)) !important;
  padding-bottom: max(8px, env(safe-area-inset-bottom)) !important;
  border-radius: 24px 24px 0 0 !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018)),
    rgba(var(--bg-surface-rgb), 0.96) !important;
  box-shadow: 0 -1px 0 var(--border-subtle), 0 -12px 34px rgba(0,0,0,0.18) !important;
}

.bottom-nav-item {
  min-width: 56px !important;
  min-height: 48px !important;
  border-radius: 16px !important;
}

.bottom-nav-item.active {
  transform: translateY(-2px) !important;
}

/* Responsive dashboard */
@media (max-width: 1200px) {
  .dash-greeting {
    grid-template-columns: minmax(0, 1fr) auto !important;
  }

  .dash-greeting-right {
    grid-column: 1 / -1 !important;
  }

  .dash-alerts-strip,
  .dash-action-toolbar {
    justify-content: flex-start !important;
  }
}

@media (max-width: 768px) {
  .dashboard-page {
    gap: 14px !important;
  }

  .dash-greeting {
    grid-template-columns: 1fr !important;
    min-height: auto !important;
    padding: 16px !important;
    border-radius: 22px !important;
  }

  .dash-greeting-left {
    align-items: flex-start !important;
  }

  .dash-greeting-icon {
    width: 42px !important;
    height: 42px !important;
    border-radius: 15px !important;
  }

  .dash-live-clock-widget {
    width: 100% !important;
    min-width: 0 !important;
    padding: 12px 13px !important;
    border-radius: 17px !important;
  }

  .clock-time {
    font-size: 1.55rem !important;
  }

  .dash-alerts-strip,
  .dash-action-toolbar {
    justify-content: stretch !important;
    width: 100% !important;
  }

  .dash-action-toolbar .btn-primary,
  .dash-action-toolbar .btn-secondary,
  .dash-action-toolbar button {
    flex: 1 1 130px !important;
    justify-content: center !important;
  }

  .dash-alert-chip {
    flex: 1 1 auto !important;
    justify-content: center !important;
  }

  .dash-stat-card,
  .app-stat-card,
  .stat-card {
    min-height: 108px !important;
    padding: 14px !important;
    border-radius: 19px !important;
  }

  .dash-chart-card,
  .dash-smart-card {
    border-radius: 20px !important;
    padding: 14px !important;
  }

  .dash-work-item,
  .dash-slot-item,
  .upcoming-item,
  .top-cust-row {
    border-radius: 14px !important;
    padding: 11px !important;
  }
}

@media (max-width: 480px) {
  .dash-greeting-title {
    font-size: 1.28rem !important;
  }

  .dash-greeting-sub {
    font-size: 0.84rem !important;
  }

  .dash-action-toolbar .btn-primary,
  .dash-action-toolbar .btn-secondary,
  .dash-action-toolbar button {
    flex-basis: 100% !important;
  }

  .bottom-nav-item {
    min-width: 48px !important;
  }
}


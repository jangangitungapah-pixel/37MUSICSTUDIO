/* ════════════════════════════════════════════════════════════════════════════
   MODERN FLAT MINIMAL SYSTEM — 37 Music Studio
   --------------------------------------------------------------------------
   New visual direction:
   - solid surfaces instead of glass/blur
   - subtle borders instead of neon glow
   - lightweight shadows instead of spatial depth
   - mobile-first performance with fewer GPU-heavy effects
   - still premium, warm, and modern — not plain default UI
   ════════════════════════════════════════════════════════════════════════════ */

:root {
  color-scheme: dark;

  /* Flat foundation */
  --bg-dark-rgb: 13, 15, 20;
  --bg-dark: #0d0f14;
  --bg-surface-rgb: 24, 27, 34;
  --bg-surface: #181b22;
  --bg-surface-hover: #20242d;

  --surface-0: #0d0f14;
  --surface-1: #151820;
  --surface-2: #1b1f29;
  --surface-3: #232936;
  --surface-soft: #11141b;
  --surface-muted: #202631;

  --text-primary: #f7f8fb;
  --text-secondary: #b8bfcc;
  --text-muted: #7f8797;
  --text-faint: #535b6b;

  --accent-pink-rgb: 247, 66, 112;
  --accent-pink: #f74270;
  --accent-pink-hover: #ff5b86;
  --accent-cyan-rgb: 48, 197, 255;
  --accent-cyan: #30c5ff;
  --accent-soft: rgba(var(--accent-pink-rgb), 0.12);
  --accent-border: rgba(var(--accent-pink-rgb), 0.24);

  --success-rgb: 42, 179, 119;
  --warning-rgb: 245, 178, 64;
  --danger-rgb: 239, 83, 95;

  --border-light: rgba(255, 255, 255, 0.08);
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.14);
  --border-focus: rgba(var(--accent-pink-rgb), 0.42);

  /* Compatibility with the old spatial/glass tokens */
  --glass-bg: var(--surface-1);
  --glass-border: var(--border-subtle);
  --glass-blur: 0px;
  --shadow-neon: none;
  --shadow-spatial: 0 1px 2px rgba(0, 0, 0, 0.22), 0 10px 24px rgba(0, 0, 0, 0.16);
  --shadow-spatial-hover: 0 2px 4px rgba(0, 0, 0, 0.24), 0 14px 28px rgba(0, 0, 0, 0.18);

  --shadow-xs: 0 1px 1px rgba(0, 0, 0, 0.18);
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.18), 0 8px 18px rgba(0, 0, 0, 0.10);
  --shadow-md: 0 2px 6px rgba(0, 0, 0, 0.20), 0 14px 28px rgba(0, 0, 0, 0.14);
  --shadow-lg: 0 6px 16px rgba(0, 0, 0, 0.24), 0 22px 44px rgba(0, 0, 0, 0.16);

  --radius-xs: 8px;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-xl: 22px;

  --durationFast: 150ms;
  --durationNormal: 200ms;
  --curveEasyEase: cubic-bezier(0.2, 0, 0, 1);
}

[data-theme="light"] {
  color-scheme: light;

  --bg-dark-rgb: 244, 246, 250;
  --bg-dark: #f4f6fa;
  --bg-surface-rgb: 255, 255, 255;
  --bg-surface: #ffffff;
  --bg-surface-hover: #f0f2f7;

  --surface-0: #f4f6fa;
  --surface-1: #ffffff;
  --surface-2: #f8f9fc;
  --surface-3: #eef1f7;
  --surface-soft: #f7f8fb;
  --surface-muted: #edf0f6;

  --text-primary: #141720;
  --text-secondary: #4e5665;
  --text-muted: #71798a;
  --text-faint: #a3aaba;

  --accent-pink-rgb: 226, 48, 91;
  --accent-pink: #e2305b;
  --accent-pink-hover: #c91f4b;
  --accent-cyan-rgb: 0, 130, 170;
  --accent-cyan: #0082aa;
  --accent-soft: rgba(var(--accent-pink-rgb), 0.10);
  --accent-border: rgba(var(--accent-pink-rgb), 0.22);

  --border-light: rgba(20, 23, 32, 0.09);
  --border-subtle: rgba(20, 23, 32, 0.09);
  --border-strong: rgba(20, 23, 32, 0.16);
  --border-focus: rgba(var(--accent-pink-rgb), 0.34);

  --glass-bg: var(--surface-1);
  --glass-border: var(--border-subtle);
  --shadow-spatial: 0 1px 2px rgba(20, 23, 32, 0.06), 0 10px 24px rgba(20, 23, 32, 0.07);
  --shadow-spatial-hover: 0 2px 4px rgba(20, 23, 32, 0.08), 0 14px 28px rgba(20, 23, 32, 0.09);

  --shadow-xs: 0 1px 1px rgba(20, 23, 32, 0.05);
  --shadow-sm: 0 1px 2px rgba(20, 23, 32, 0.06), 0 8px 18px rgba(20, 23, 32, 0.05);
  --shadow-md: 0 2px 6px rgba(20, 23, 32, 0.08), 0 14px 28px rgba(20, 23, 32, 0.07);
  --shadow-lg: 0 6px 16px rgba(20, 23, 32, 0.10), 0 22px 44px rgba(20, 23, 32, 0.08);
}

html {
  background: var(--bg-dark);
}

body {
  background:
    radial-gradient(circle at top left, rgba(var(--accent-pink-rgb), 0.05), transparent 32rem),
    linear-gradient(180deg, var(--surface-0), var(--bg-dark));
  color: var(--text-primary);
}

[data-theme="light"] body {
  background: linear-gradient(180deg, #fbfcff, var(--bg-dark));
}

/* Remove the old ambient/spatial decoration layer from the product UI. */
.ambient-glow-wrapper,
.ambient-blob,
.ambient-orb,
.calendar-ambient-bg,
.gallery-bg-blobs,
.gallery-blob,
.auth-bg-blob,
.empty-state-glow,
.lightbox-ambilight {
  display: none !important;
  animation: none !important;
}

/* Global glass-to-flat reset. */
.glass-panel,
.app-panel,
.app-card,
.app-stat-card,
.app-smart-panel,
.app-table-panel,
.stat-card,
.dash-stat-card,
.dash-chart-card,
.dash-smart-card,
.finance-stat-card,
.billing-stat-card,
.maint-stat-card,
.staff-card,
.feature-card,
.reset-option-card,
.pricing-info-card,
.cf-status-card,
.bf-status-card,
.mobile-customer-card,
.mobile-inv-card,
.mobile-billing-card,
.mobile-ledger-card,
.mobile-maint-card,
.customer-detail-panel,
.item-detail-panel,
.card-interactive,
.smart-item,
.maint-smart-panel,
.maint-modal-info,
.lightbox-settings-panel,
.booking-detail-popup,
.nav-login-dropdown,
.notif-panel,
.fluent-dialog,
.fluent-popover,
.auth-card,
.login-dropdown-header,
.price-card,
.experience-card,
.flow-panel,
.proof-grid > div,
.pc-calendar-intro,
.pc-toolbar,
.pc-grid-shell,
.pc-public-status,
.pc-avail-chip,
.pc-hero-stats > div,
.pc-view-switch,
.pc-legend,
.pc-gallery-card {
  background: var(--surface-1) !important;
  border: 1px solid var(--border-subtle) !important;
  box-shadow: var(--shadow-sm) !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

.glass-panel:hover,
.app-panel:hover,
.app-card:hover,
.app-stat-card:hover,
.stat-card:hover,
.dash-stat-card:hover,
.dash-chart-card:hover,
.dash-smart-card:hover,
.finance-stat-card:hover,
.billing-stat-card:hover,
.staff-card:hover,
.feature-card:hover,
.card-interactive:hover,
.mobile-customer-card:hover,
.mobile-inv-card:hover,
.mobile-billing-card:hover,
.mobile-ledger-card:hover,
.mobile-maint-card:hover,
.smart-item:hover,
.experience-card:hover,
.price-card:hover,
.pc-gallery-card:hover {
  transform: translateY(-1px) !important;
  border-color: var(--border-strong) !important;
  box-shadow: var(--shadow-md) !important;
}

/* Admin shell */
.app-container {
  background: var(--bg-dark) !important;
}

.main-content {
  background: transparent !important;
}

/* Sidebar and mobile navigation become solid app chrome. */
.sidebar,
.mobile-command-header,
.bottom-nav-bar,
.landing-nav,
.landing-nav.scrolled,
.mobile-nav-menu,
.pc-topbar {
  background: var(--surface-1) !important;
  border-color: var(--border-subtle) !important;
  box-shadow: var(--shadow-sm) !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

.nav-item,
.settings-nav-item,
.mobile-nav-item,
.bottom-nav-item,
.pc-view-btn,
.filter-chip,
.today-btn,
.nav-theme-btn,
.nav-login-btn,
.nav-hamburger,
.pc-theme-btn,
.pc-exit-btn,
.icon-btn,
.view-switcher button {
  background: transparent !important;
  border: 1px solid transparent !important;
  color: var(--text-secondary) !important;
  box-shadow: none !important;
}

.nav-item:hover,
.settings-nav-item:hover,
.mobile-nav-item:hover,
.bottom-nav-item:hover,
.pc-view-btn:hover,
.filter-chip:hover,
.today-btn:hover,
.nav-theme-btn:hover,
.nav-login-btn:hover,
.nav-hamburger:hover,
.pc-theme-btn:hover,
.pc-exit-btn:hover,
.icon-btn:hover,
.view-switcher button:hover {
  background: var(--surface-2) !important;
  color: var(--text-primary) !important;
  border-color: var(--border-subtle) !important;
}

.nav-item.active,
.settings-nav-item.active,
.mobile-nav-item.active,
.bottom-nav-item.active,
.pc-view-btn.active,
.filter-chip.active,
.view-switcher button.active {
  background: var(--accent-soft) !important;
  color: var(--accent-pink) !important;
  border-color: var(--accent-border) !important;
}

.nav-icon,
.auth-header-logo,
.stat-icon-wrapper,
.dash-stat-icon,
.experience-icon,
.login-dropdown-icon-wrap,
.pc-brand-mark,
.nav-brand-mark {
  background: var(--surface-2) !important;
  border: 1px solid var(--border-subtle) !important;
  box-shadow: none !important;
}

/* Buttons */
.btn-primary,
.auth-submit,
.login-dropdown-submit,
.nav-book-btn,
.mobile-menu-booking,
.pc-primary-link,
.landing-container .btn-primary,
button[type="submit"].btn-primary,
button[type="button"].btn-primary {
  background: var(--accent-pink) !important;
  color: #ffffff !important;
  border: 1px solid transparent !important;
  box-shadow: 0 8px 18px rgba(var(--accent-pink-rgb), 0.20) !important;
  border-radius: var(--radius-md) !important;
  transition: transform var(--durationFast) var(--curveEasyEase), box-shadow var(--durationFast) var(--curveEasyEase), background-color var(--durationFast) var(--curveEasyEase) !important;
}

.btn-primary:hover,
.auth-submit:hover,
.login-dropdown-submit:hover,
.nav-book-btn:hover,
.mobile-menu-booking:hover,
.pc-primary-link:hover,
.landing-container .btn-primary:hover,
button[type="submit"].btn-primary:hover,
button[type="button"].btn-primary:hover {
  background: var(--accent-pink-hover) !important;
  color: #ffffff !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 10px 22px rgba(var(--accent-pink-rgb), 0.24) !important;
}

.btn-secondary,
.auth-guest-btn,
.security-secondary-action,
.landing-container .btn-secondary,
.pc-wa-quick-btn,
.chart-link-btn,
.qb-btn,
.qe-btn,
.dash-action-toolbar .btn-secondary,
button[type="button"].btn-secondary {
  background: var(--surface-2) !important;
  color: var(--text-primary) !important;
  border: 1px solid var(--border-subtle) !important;
  box-shadow: none !important;
  border-radius: var(--radius-md) !important;
}

.btn-secondary:hover,
.auth-guest-btn:hover,
.landing-container .btn-secondary:hover,
.pc-wa-quick-btn:hover,
.chart-link-btn:hover,
.qb-btn:hover,
.qe-btn:hover,
.dash-action-toolbar .btn-secondary:hover,
button[type="button"].btn-secondary:hover {
  background: var(--surface-3) !important;
  border-color: var(--border-strong) !important;
  color: var(--text-primary) !important;
  transform: translateY(-1px) !important;
}

button:disabled,
.btn-primary:disabled,
.btn-secondary:disabled {
  opacity: 0.58 !important;
  cursor: not-allowed !important;
  transform: none !important;
  box-shadow: none !important;
}

/* Forms */
input,
textarea,
select,
.form-input,
.bf-input,
.login-field-input,
.app-search,
.search-bar,
.search-input-wrapper,
.maint-input-wrapper,
[class*="input-wrap"],
[class*="field-wrap"] {
  background: var(--surface-2) !important;
  color: var(--text-primary) !important;
  border-color: var(--border-subtle) !important;
  box-shadow: none !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

input:hover,
textarea:hover,
select:hover,
.form-input:hover,
.bf-input:hover,
.login-field-input:hover,
.app-search:hover,
.search-bar:hover,
.search-input-wrapper:hover {
  border-color: var(--border-strong) !important;
}

input:focus,
textarea:focus,
select:focus,
.form-input:focus,
.bf-input:focus,
.login-field-input:focus,
.search-bar:focus-within,
.search-input-wrapper:focus-within,
.app-search:focus-within {
  outline: none !important;
  border-color: var(--border-focus) !important;
  box-shadow: 0 0 0 3px rgba(var(--accent-pink-rgb), 0.12) !important;
}

label,
.login-field-label,
.form-group label,
.bf-label {
  color: var(--text-secondary) !important;
  font-weight: 700 !important;
}

/* Tables */
table,
.data-table,
.app-table,
.table-responsive,
.app-table-wrapper {
  background: var(--surface-1) !important;
  border-color: var(--border-subtle) !important;
  box-shadow: none !important;
}

thead th,
.table-header th,
.grid-header-cell,
.day-header-cell,
.sticky-col,
.time-label,
.grid-corner-cell,
.pc-header-cell,
.pc-time-cell {
  background: var(--surface-2) !important;
  color: var(--text-muted) !important;
  border-color: var(--border-subtle) !important;
  box-shadow: none !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

tbody td,
td,
.grid-cell,
.pc-grid-cell {
  border-color: var(--border-subtle) !important;
  color: var(--text-primary) !important;
}

tbody tr:hover td,
.table-row:hover,
.grid-cell:hover,
.pc-grid-cell:hover {
  background: rgba(var(--accent-pink-rgb), 0.05) !important;
}

/* Status and badges */
.badge,
.status-badge,
.filter-chip,
.pc-dot,
.pc-avail-chip,
[class*="status"],
[class*="badge"] {
  box-shadow: none !important;
  text-shadow: none !important;
}

/* Modals and overlays */
.modal-overlay,
.gallery-lightbox-overlay,
.mobile-nav-backdrop {
  background: rgba(0, 0, 0, 0.42) !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

.modal-container,
.modal-content,
.modal-wrapper > .modal-content,
.fluent-dialog,
.booking-detail-popup.mobile-sheet,
.lightbox-content {
  background: var(--surface-1) !important;
  border: 1px solid var(--border-subtle) !important;
  box-shadow: var(--shadow-lg) !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

.modal-header,
.modal-footer,
.detail-header,
.detail-footer {
  border-color: var(--border-subtle) !important;
}

/* Dashboard/list cleanups */
.dash-alert-chip,
.dash-work-item,
.dash-slot-item,
.upcoming-item,
.top-cust-row,
.permission-card,
.reset-option-card,
.settings-card,
.album-card,
.gallery-card,
.landing-gallery-card,
.pc-gallery-card {
  background: var(--surface-2) !important;
  border: 1px solid var(--border-subtle) !important;
  box-shadow: none !important;
}

.dash-alert-chip:hover,
.dash-work-item:hover,
.dash-slot-item:hover,
.upcoming-item:hover,
.top-cust-row:hover,
.permission-card:hover,
.reset-option-card:hover,
.settings-card:hover,
.album-card:hover,
.gallery-card:hover,
.landing-gallery-card:hover,
.pc-gallery-card:hover {
  background: var(--surface-3) !important;
  border-color: var(--border-strong) !important;
  transform: translateY(-1px) !important;
}

.album-card::before,
.album-card::after,
.landing-gallery-card::before,
.landing-gallery-card::after {
  display: none !important;
}

/* Landing page: keep premium, remove GPU-heavy glass language. */
.landing-container {
  background: var(--bg-dark) !important;
}

.hero-section,
.pc-hero {
  background: var(--surface-0) !important;
}

.hero-background::after,
.pc-hero-media::after,
.hero-scrim,
.pc-hero-scrim {
  background: linear-gradient(90deg, rgba(13, 15, 20, 0.78), rgba(13, 15, 20, 0.34), rgba(13, 15, 20, 0.68)) !important;
}

[data-theme="light"] .hero-background::after,
[data-theme="light"] .pc-hero-media::after,
[data-theme="light"] .hero-scrim,
[data-theme="light"] .pc-hero-scrim {
  background: linear-gradient(90deg, rgba(20, 23, 32, 0.70), rgba(20, 23, 32, 0.30), rgba(20, 23, 32, 0.60)) !important;
}

.hero-kicker,
.section-eyebrow,
.experience-label,
.session-label,
.pc-hero-kicker {
  color: var(--accent-pink) !important;
  text-shadow: none !important;
}

.hero-session,
.flow-step,
.pricing-includes > div,
.footer-contact,
.footer-map,
.map-container {
  background: var(--surface-1) !important;
  border: 1px solid var(--border-subtle) !important;
  box-shadow: var(--shadow-sm) !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}

/* Public calendar */
.pc-page,
.calendar-page,
.gallery-page,
.app-page {
  background: transparent !important;
}

.pc-body,
.calendar-container,
.pc-grid-wrapper {
  background: transparent !important;
}

.empty-cell,
.pc-empty-cell {
  background: transparent !important;
}

.booked-cell,
.pc-booked-cell {
  background: var(--surface-2) !important;
  border-color: var(--border-subtle) !important;
  box-shadow: none !important;
}

.current-time-line,
.current-time-line::before {
  box-shadow: none !important;
  animation: none !important;
}

/* Charts and export surfaces */
.recharts-wrapper,
.recharts-surface {
  filter: none !important;
}

/* Lightweight motion: keep UI alive, not expensive. */
* {
  transition-duration: var(--durationFast);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.001ms !important;
  }
}

/* Tablet and smartphone performance pass */
@media (max-width: 1024px) {
  body {
    background: var(--bg-dark) !important;
  }

  .main-content {
    padding-left: 14px !important;
    padding-right: 14px !important;
  }

  .glass-panel,
  .app-panel,
  .app-card,
  .app-stat-card,
  .app-smart-panel,
  .app-table-panel,
  .stat-card,
  .dash-stat-card,
  .dash-chart-card,
  .dash-smart-card,
  .finance-stat-card,
  .billing-stat-card,
  .maint-stat-card,
  .staff-card,
  .mobile-customer-card,
  .mobile-inv-card,
  .mobile-billing-card,
  .mobile-ledger-card,
  .mobile-maint-card,
  .customer-detail-panel,
  .item-detail-panel,
  .smart-item,
  .modal-container,
  .modal-content,
  .booking-detail-popup,
  .nav-login-dropdown,
  .notif-panel,
  .sidebar,
  .mobile-command-header,
  .bottom-nav-bar,
  .landing-nav,
  .mobile-nav-menu,
  .pc-topbar,
  .pc-toolbar,
  .pc-grid-shell {
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    box-shadow: var(--shadow-xs) !important;
  }

  .glass-panel:hover,
  .app-panel:hover,
  .app-card:hover,
  .app-stat-card:hover,
  .stat-card:hover,
  .dash-stat-card:hover,
  .dash-chart-card:hover,
  .dash-smart-card:hover,
  .finance-stat-card:hover,
  .billing-stat-card:hover,
  .staff-card:hover,
  .mobile-customer-card:hover,
  .mobile-inv-card:hover,
  .mobile-billing-card:hover,
  .mobile-ledger-card:hover,
  .mobile-maint-card:hover,
  .smart-item:hover,
  .album-card:hover,
  .gallery-card:hover,
  .pc-gallery-card:hover,
  .landing-gallery-card:hover {
    transform: none !important;
    box-shadow: var(--shadow-xs) !important;
  }

  .btn-primary:hover,
  .btn-secondary:hover,
  .icon-btn:hover,
  .nav-item:hover,
  .bottom-nav-item:hover,
  .pc-view-btn:hover {
    transform: none !important;
  }

  .glass-panel:active,
  .app-panel:active,
  .app-card:active,
  .card-interactive:active,
  .app-stat-card:active,
  .stat-card:active,
  .dash-stat-card:active,
  .dash-smart-card:active,
  .staff-card:active,
  .mobile-customer-card:active,
  .mobile-inv-card:active,
  .mobile-billing-card:active,
  .mobile-ledger-card:active,
  .mobile-maint-card:active,
  .btn-primary:active,
  .btn-secondary:active,
  .icon-btn:active {
    transform: scale(0.99) !important;
  }

  .modal-overlay {
    background: rgba(0, 0, 0, 0.36) !important;
  }

  .modal-container,
  .modal-content {
    border-radius: 20px 20px 0 0 !important;
    box-shadow: 0 -10px 28px rgba(0, 0, 0, 0.22) !important;
  }

  .hero-section,
  .pc-hero {
    min-height: auto !important;
  }

  .hero-title,
  .pc-hero-title {
    letter-spacing: -0.045em !important;
  }

  .hero-subtitle,
  .pc-hero-sub,

  background: rgba(255,255,255,0.40) !important;
}

.timeline-booking-card:hover .timeline-resize-handle {
  opacity: 1 !important;
}

.vertical-time-line {
  position: absolute !important;
  top: 0 !important;
  bottom: 0 !important;
  width: 2px !important;
  height: auto !important;
  transform: translateX(-1px) !important;

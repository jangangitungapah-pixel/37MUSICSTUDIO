  --spatial-radius-panel: 24px;
  --spatial-radius-card: 20px;
  --spatial-radius-control: 14px;

  --depth-line: inset 0 1px 0 rgba(255, 255, 255, 0.045);
  --depth-1: 0 1px 2px rgba(0, 0, 0, 0.22), 0 8px 18px rgba(0, 0, 0, 0.12);
  --depth-2: 0 2px 6px rgba(0, 0, 0, 0.22), 0 18px 38px rgba(0, 0, 0, 0.16);
  --depth-3: 0 10px 26px rgba(0, 0, 0, 0.26), 0 30px 70px rgba(0, 0, 0, 0.18);
  --depth-accent: 0 0 0 1px rgba(var(--accent-pink-rgb), 0.18), 0 18px 42px rgba(var(--accent-pink-rgb), 0.10);

  --surface-spatial: linear-gradient(180deg, rgba(255,255,255,0.035), rgba(255,255,255,0.012)), var(--surface-1);
  --surface-spatial-raised: linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018)), var(--surface-2);
  --surface-spatial-soft: linear-gradient(180deg, rgba(var(--accent-pink-rgb),0.055), rgba(255,255,255,0.012)), var(--surface-1);

  --ambient-pink-soft: rgba(var(--accent-pink-rgb), 0.115);
  --ambient-cyan-soft: rgba(var(--accent-cyan-rgb), 0.085);
  --ambient-violet-soft: rgba(132, 92, 255, 0.08);
}

[data-theme="light"] {
  --depth-line: inset 0 1px 0 rgba(255, 255, 255, 0.92);
  --depth-1: 0 1px 2px rgba(20, 23, 32, 0.06), 0 10px 22px rgba(20, 23, 32, 0.055);
  --depth-2: 0 2px 7px rgba(20, 23, 32, 0.075), 0 18px 42px rgba(20, 23, 32, 0.08);
  --depth-3: 0 12px 28px rgba(20, 23, 32, 0.10), 0 34px 76px rgba(20, 23, 32, 0.10);
  --depth-accent: 0 0 0 1px rgba(var(--accent-pink-rgb), 0.15), 0 18px 42px rgba(var(--accent-pink-rgb), 0.075);

  --surface-spatial: linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.70)), var(--surface-1);
  --surface-spatial-raised: linear-gradient(180deg, rgba(255,255,255,1), rgba(248,249,252,0.88)), var(--surface-1);
  --surface-spatial-soft: linear-gradient(180deg, rgba(var(--accent-pink-rgb),0.055), rgba(255,255,255,0.78)), var(--surface-1);

  --ambient-pink-soft: rgba(var(--accent-pink-rgb), 0.09);
  --ambient-cyan-soft: rgba(var(--accent-cyan-rgb), 0.075);
  --ambient-violet-soft: rgba(132, 92, 255, 0.055);
}


/* ════════════════════════════════════════════════════════════════════════════
   37 CALENDAR BOARD DENSITY FIX V2
   --------------------------------------------------------------------------
   Turns month calendar into a real wide scheduling board:
   readable columns, sticky time/date headers, compact booking cards.
   ════════════════════════════════════════════════════════════════════════════ */

.calendar-workspace {
  overflow: hidden !important;
  border-radius: 28px !important;
}

.calendar-workspace-toolbar {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 14px !important;
  flex-wrap: wrap !important;
  padding: 14px !important;
  border-bottom: 1px solid var(--border-subtle) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.012)),
    rgba(var(--bg-surface-rgb), 0.62) !important;
}

.calendar-toolbar-left,
.calendar-toolbar-right {
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  flex-wrap: wrap !important;
}

.current-month {
  min-width: 170px !important;
  text-align: center !important;
  font-weight: 950 !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
}

/* The real calendar scroll container */
.monthly-grid-wrapper {
  position: relative !important;
  width: 100% !important;
  overflow: auto !important;
  -webkit-overflow-scrolling: touch !important;
  overscroll-behavior: contain !important;
  border-radius: 0 0 26px 26px !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.018), rgba(255,255,255,0.006)),
    var(--surface-0) !important;
  scrollbar-width: thin !important;
  scrollbar-color: rgba(var(--accent-pink-rgb), 0.48) rgba(255,255,255,0.035) !important;
}

/* Critical: never compress month view into one viewport */
.monthly-grid {
  width: max-content !important;
  min-width: 100% !important;
  align-items: stretch !important;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px),
    linear-gradient(180deg, rgba(255,255,255,0.018) 1px, transparent 1px),

/* ════════════════════════════════════════════════════════════════════════════
   37 CALENDAR TIMELINE AXIS
   --------------------------------------------------------------------------
   All calendar views use: date rows ↓ and hour columns →.
   This makes booking duration readable as horizontal timeline bars.
   ════════════════════════════════════════════════════════════════════════════ */

.calendar-workspace {
  overflow: hidden !important;
  border-radius: 28px !important;
}

.calendar-workspace-toolbar {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 14px !important;
  flex-wrap: wrap !important;
  padding: 14px !important;
  border-bottom: 1px solid var(--border-subtle) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.012)),
    rgba(var(--bg-surface-rgb), 0.62) !important;
}

.calendar-toolbar-left,
.calendar-toolbar-right {
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  flex-wrap: wrap !important;
}

.current-month {
  min-width: 170px !important;
  text-align: center !important;
  font-weight: 950 !important;
  letter-spacing: 0.06em !important;
  text-transform: uppercase !important;
}

.calendar-timeline-wrapper {
  position: relative !important;
  width: 100% !important;
  max-height: calc(100vh - 230px) !important;
  overflow: auto !important;
  -webkit-overflow-scrolling: touch !important;
  overscroll-behavior: contain !important;
  border-radius: 0 0 26px 26px !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.018), rgba(255,255,255,0.006)),
    var(--surface-0) !important;
  scrollbar-width: thin !important;
  scrollbar-color: rgba(var(--accent-pink-rgb), 0.48) rgba(255,255,255,0.035) !important;
}

.calendar-timeline-grid {
  width: max-content !important;
  min-width: 100% !important;
  align-items: stretch !important;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px),
    linear-gradient(180deg, rgba(255,255,255,0.018) 1px, transparent 1px),
    var(--surface-0) !important;
  background-size: 128px 100%, 100% 64px, auto !important;
}

/* Sticky corner */
.timeline-corner {
  position: sticky !important;
  top: 0 !important;
  left: 0 !important;
  z-index: 50 !important;
  min-width: 118px !important;
  background:
    linear-gradient(180deg, rgba(var(--accent-cyan-rgb), 0.12), rgba(var(--accent-cyan-rgb), 0.035)),
    var(--surface-2) !important;
  border-right: 1px solid var(--border-strong) !important;
  border-bottom: 1px solid var(--border-strong) !important;
}

.corner-label {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 28px !important;
  padding: 0 12px !important;
  border-radius: 8px !important;
  background: rgba(var(--accent-cyan-rgb), 0.09) !important;
  color: var(--accent-cyan) !important;
  border: 1px solid rgba(var(--accent-cyan-rgb), 0.22) !important;
  font-size: 0.72rem !important;
  font-weight: 950 !important;
  letter-spacing: 0.08em !important;
}

/* Sticky hour header */
.timeline-hour-header {
  position: sticky !important;
  top: 0 !important;
  z-index: 40 !important;
  min-width: 128px !important;
  height: 56px !important;
  padding: 8px 8px !important;
  display: grid !important;
  align-content: center !important;
  justify-items: center !important;
  border-right: 1px solid rgba(255,255,255,0.055) !important;
  border-bottom: 1px solid var(--border-strong) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.018)),
    var(--surface-2) !important;
}

.timeline-hour-header.even-hour {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.085), rgba(255,255,255,0.018)),
    var(--surface-2) !important;
}

.timeline-hour-header.current-hour {
  background:
    radial-gradient(circle at 50% 0%, rgba(var(--accent-pink-rgb), 0.18), transparent 56%),
    var(--surface-2) !important;
  border-color: rgba(var(--accent-pink-rgb), 0.22) !important;
}

.timeline-hour-label {
  display: block !important;
  color: var(--text-primary) !important;
  font-size: 0.9rem !important;
  font-weight: 950 !important;
  letter-spacing: -0.035em !important;
}

.timeline-hour-end {
  display: block !important;
  margin-top: 2px !important;
  color: var(--text-muted) !important;
  font-size: 0.64rem !important;
  font-weight: 850 !important;
}

/* Sticky date rows */
.timeline-date-cell {
  position: sticky !important;
  left: 0 !important;
  z-index: 35 !important;
  width: 118px !important;
  min-width: 118px !important;
  padding: 8px 10px !important;
  display: grid !important;
  grid-template-columns: 1fr auto !important;
  align-content: center !important;
  gap: 2px 8px !important;
  border-right: 1px solid var(--border-strong) !important;
  border-bottom: 1px solid rgba(255,255,255,0.055) !important;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.055), rgba(255,255,255,0.015)),
    var(--surface-1) !important;
}

.timeline-date-cell.weekend-date {
  background:
    linear-gradient(90deg, rgba(var(--accent-pink-rgb), 0.055), rgba(255,255,255,0.015)),
    var(--surface-1) !important;
}

.timeline-date-cell.today-date {
  background:
    linear-gradient(90deg, rgba(var(--accent-pink-rgb), 0.14), rgba(var(--accent-cyan-rgb), 0.045)),
    var(--surface-1) !important;
  border-right-color: rgba(var(--accent-pink-rgb), 0.34) !important;
}

.timeline-date-day {
  display: block !important;
  color: var(--text-muted) !important;
  font-size: 0.66rem !important;
  font-weight: 950 !important;
  letter-spacing: 0.08em !important;
  text-transform: uppercase !important;
}

.timeline-date-number {
  display: block !important;
  grid-row: 2 !important;
  color: var(--text-primary) !important;
  font-size: 1.15rem !important;
  font-weight: 950 !important;
  letter-spacing: -0.06em !important;
  line-height: 1 !important;
}

.today-date .timeline-date-number {
  color: var(--accent-pink) !important;
}

.timeline-date-alert {
  grid-column: 2 !important;
  grid-row: 1 / span 2 !important;
  align-self: center !important;
  color: var(--accent-pink) !important;
}

/* Empty timeline slot */
.timeline-slot-cell {
  min-width: 128px !important;
  min-height: 66px !important;
  border-right: 1px solid rgba(255,255,255,0.045) !important;
  border-bottom: 1px solid rgba(255,255,255,0.04) !important;
  background: rgba(255,255,255,0.003) !important;
}

.timeline-slot-cell.even-hour {
  background: rgba(255,255,255,0.008) !important;
}

.timeline-slot-cell.weekend-row {
  background: rgba(var(--accent-pink-rgb), 0.010) !important;
}

.timeline-slot-cell.today-row-highlight {
  background:
    linear-gradient(90deg, rgba(var(--accent-pink-rgb), 0.020), rgba(var(--accent-cyan-rgb), 0.018)) !important;
}

.timeline-slot-cell:hover {
  background: rgba(var(--accent-cyan-rgb), 0.045) !important;
}

.hover-plus {
  opacity: 0 !important;
  transform: scale(0.86) !important;
  transition: opacity 150ms var(--curveEasyEase), transform 150ms var(--curveEasyEase) !important;
}

.timeline-slot-cell:hover .hover-plus {
  opacity: 1 !important;
  transform: scale(1) !important;
  color: var(--accent-cyan) !important;
}

/* Booking as horizontal bar */
.timeline-booking-card {
  margin: 8px 6px !important;
  min-height: 48px !important;
  padding: 8px 34px 8px 12px !important;
  border-radius: 14px !important;
  border: 1px solid rgba(255,255,255,0.11) !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.082), rgba(255,255,255,0.018)),
    rgba(var(--bg-surface-rgb), 0.88) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.07),
    0 8px 18px rgba(0,0,0,0.18) !important;
  overflow: hidden !important;
  cursor: pointer !important;
}

.timeline-booking-card::before {
  content: "" !important;
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  bottom: 0 !important;
  width: 5px !important;
  border-radius: 999px !important;
  background: var(--accent-pink) !important;
}

.timeline-booking-card.status-confirmed::before {
  background: rgb(var(--success-rgb)) !important;
}

.timeline-booking-card.status-dp::before {
  background: var(--accent-cyan) !important;
}

.timeline-booking-card.status-pending::before {
  background: rgb(var(--warning-rgb)) !important;
}

.timeline-booking-card.status-maintenance::before {
  background: var(--text-muted) !important;
}

.timeline-booking-card.status-confirmed {
  background:
    linear-gradient(180deg, rgba(var(--success-rgb), 0.105), rgba(255,255,255,0.018)),
    rgba(var(--bg-surface-rgb), 0.88) !important;
}

.timeline-booking-card.status-dp {
  background:
    linear-gradient(180deg, rgba(var(--accent-cyan-rgb), 0.10), rgba(255,255,255,0.018)),
    rgba(var(--bg-surface-rgb), 0.88) !important;
}

.timeline-booking-card.status-pending {
  background:
    linear-gradient(180deg, rgba(var(--warning-rgb), 0.11), rgba(255,255,255,0.018)),
    rgba(var(--bg-surface-rgb), 0.88) !important;
}

.timeline-booking-card.status-cancelled {
  opacity: 0.58 !important;
  filter: saturate(0.75) !important;
}

.timeline-booking-card:hover {
  transform: translateY(-1px) !important;
  border-color: rgba(255,255,255,0.18) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.08),
    0 12px 24px rgba(0,0,0,0.22) !important;
}

.timeline-booking-card .booking-info {
  display: grid !important;
  gap: 5px !important;
  min-width: 0 !important;
}

.timeline-booking-card .booking-band-name {
  display: block !important;
  max-width: 100% !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  white-space: nowrap !important;
  color: var(--text-primary) !important;
  font-size: 0.86rem !important;
  line-height: 1.1 !important;
  font-weight: 950 !important;
  letter-spacing: -0.035em !important;
  text-shadow: 0 1px 0 rgba(0,0,0,0.25) !important;
}

.timeline-booking-card .booking-meta-row {
  min-width: 0 !important;
  gap: 6px !important;
  flex-wrap: nowrap !important;
  overflow: hidden !important;
}

.timeline-booking-card .booking-time-label {
  display: block !important;
  min-width: 0 !important;
